---
import Layout from '../../layouts/Layout.astro';
import { OTHER_JOB_CATEGORY, parseJobCategory } from '@/lib/categories';
import { findPublicJob, type PublicJob } from '@/lib/public-board';
import { applySnapshotHeaders, loadPublicBoard } from '@/lib/public-serving-snapshot';
import { serializeJsonLd } from '@/lib/json-ld';
import { sanitizeSourceUrl, classifyShift } from '@va-hub/scraper';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { companyLogoDomains, withCompanyLogo } from '@/lib/company-identity';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const { id } = Astro.params;
const numericId = Number(id);

if (!id || !/^[1-9]\d*$/.test(id) || !Number.isSafeInteger(numericId)) {
  return new Response('Not found', { status: 404 });
}

let job: PublicJob | null = null;
let logoDomain: string | null = null;
let dataUnavailable = false;

try {
  const board = await loadPublicBoard(Astro.locals.runtime.env, Astro.locals.runtime.ctx);
  applySnapshotHeaders(Astro.response.headers);
  job = findPublicJob(board.jobs, numericId);
  if (job) logoDomain = withCompanyLogo(job, companyLogoDomains(board.directory)).logoDomain;
} catch (e) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, e);
}

if (dataUnavailable) {
  return new Response('Service temporarily unavailable', {
    status: 503,
    headers: Astro.response.headers,
  });
}

if (!job) {
  return new Response('Not found', { status: 404 });
}

const shiftInfo = classifyShift({
  clientTimezone: job.clientTimezone,
  description: job.description,
  title: job.title,
});

// --- Source-aware description display (ADR-003) ---
const DESCRIPTION_ALLOWED_PLATFORMS = new Set([
  'WeWorkRemotely',
  'Remotive',
  'RealWorkFromAnywhere',
  'Jobicy',
  'RemoteOK',
]);

const canShowDescription =
  !!job.description && DESCRIPTION_ALLOWED_PLATFORMS.has(job.sourcePlatform);

let displayDescription = '';
let isTruncated = false;
if (canShowDescription && job.description) {
  if (job.description.length < 300) {
    displayDescription = job.description;
  } else {
    displayDescription = job.description.slice(0, 500).trimEnd();
    const lastSpace = displayDescription.lastIndexOf(' ');
    if (lastSpace > 400) {
      displayDescription = displayDescription.slice(0, lastSpace);
    }
    isTruncated = true;
  }
}

// --- Platform labels & apply link ---
const PLATFORM_LABELS: Record<string, string> = {
  WeWorkRemotely: 'We Work Remotely',
  RealWorkFromAnywhere: 'Real Work From Anywhere',
  RemoteOK: 'Remote OK',
};
const platformLabel = PLATFORM_LABELS[job.sourcePlatform] ?? job.sourcePlatform;

const isRemoteOk = job.sourcePlatform === 'RemoteOK';
const safeSourceUrl = sanitizeSourceUrl(job.sourceUrl);
const applyHref = safeSourceUrl
  ? isRemoteOk
    ? safeSourceUrl
    : `/api/click/${job.id}?url=${encodeURIComponent(job.sourceUrl)}`
  : null;
const applyRel = isRemoteOk ? 'noopener' : 'noopener noreferrer';

// --- Metadata ---
const TYPE_LABELS: Record<string, string> = {
  VA: 'VA',
  freelance: 'Freelance',
  project: 'Project',
  'full-time': 'Full-time',
  'part-time': 'Part-time',
};

const GEO_LABELS: Record<string, string> = {
  ph_only: 'Philippines',
  apac_incl_ph: 'APAC incl. PH',
  worldwide: 'Worldwide',
};

const typeLabel = TYPE_LABELS[job.type] ?? job.type;
const categoryInfo = parseJobCategory(job.category) ?? OTHER_JOB_CATEGORY;
const geoLabel = job.geoScope ? GEO_LABELS[job.geoScope] : undefined;
const isLikely = job.phEligibility === 'eligible_likely';
const companyWords = (job.company ?? '').trim().split(/\s+/).filter(Boolean);
const initials = companyWords.length > 1
  ? `${Array.from(companyWords[0])[0]}${Array.from(companyWords[1])[0]}`.toUpperCase()
  : companyWords.length === 1 ? Array.from(companyWords[0]).slice(0, 2).join('').toUpperCase() : '—';

function categoryTitle(title: string) {
  return title.replace(/\b[A-Z]+\b/g, (word) =>
    word === 'AI' || word === 'IT' ? word : word[0] + word.slice(1).toLowerCase()
  );
}

const manilaDate = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric',
});

function formatDate(isoString: string | null | undefined): string | null {
  if (!isoString) return null;
  try {
    const d = new Date(isoString);
    if (isNaN(d.getTime())) return null;
    return manilaDate.format(d);
  } catch {
    return null;
  }
}

const sourcePostedDate = formatDate(job.postedAt);
const postedDate = sourcePostedDate ?? formatDate(job.scrapedAt);
const postedDateLabel = sourcePostedDate ? 'Source posted' : 'First seen by index';
const displayDateTime = sourcePostedDate ? job.postedAt : job.scrapedAt;
const isoPostedDate = job.postedAt ?? job.scrapedAt ?? '';

const pageTitle = `${job.title}${job.company ? ` at ${job.company}` : ''} — VA & Freelance Hub`;
const pageDescription = `${typeLabel} role${job.company ? ` at ${job.company}` : ''}. ${job.locationType === 'remote' ? 'Remote role. ' : ''}Apply on ${platformLabel}.`;

// --- JobPosting JSON-LD (ADR-003 §5) ---
const EMPLOYMENT_TYPE_MAP: Record<string, string> = {
  'full-time': 'FULL_TIME',
  'part-time': 'PART_TIME',
  freelance: 'CONTRACTOR',
  project: 'TEMPORARY',
  VA: 'CONTRACTOR',
};

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: job.title,
  description: canShowDescription ? displayDescription : job.title,
  datePosted: isoPostedDate,
  jobLocationType: 'TELECOMMUTE',
};

if (job.company) {
  jsonLd.hiringOrganization = {
    '@type': 'Organization',
    name: job.company,
  };
}

if (job.type && EMPLOYMENT_TYPE_MAP[job.type]) {
  jsonLd.employmentType = EMPLOYMENT_TYPE_MAP[job.type];
}

if (job.phEligibility === 'eligible_verified') {
  jsonLd.applicantLocationRequirements = {
    '@type': 'Country',
    name: 'Philippines',
  };
}

jsonLd.directApply = false;
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} slot="head" />

  <section class="page-section job-detail">
    <a href="/opportunities" class="detail-back text-link">← All jobs</a>

    <article>
      <header class="detail-heading">
        <span class="opportunity-initials company-mark" aria-hidden="true">
          <span>{initials}</span>
          {logoDomain && <img src={`/api/company-logo?domain=${encodeURIComponent(logoDomain)}&initial=${encodeURIComponent(initials[0])}`} width="40" height="40" alt="" loading="lazy" decoding="async" data-company-logo="" />}
        </span>
        <div>
          <h1 class="page-title">{job.title}</h1>
          {job.company && <p class="detail-company">{job.company}</p>}
          <div class="detail-status">
            {geoLabel ? (
              <span class:list={['opportunity-geo', { 'opportunity-geo-likely': isLikely }]} title={job.geoEvidence ?? undefined}>
                {geoLabel}{isLikely ? ' · likely' : ''}
              </span>
            ) : (
              <span class="text-muted">Geographic scope unspecified</span>
            )}
          </div>
        </div>
      </header>

      <div class="detail-layout">
        <aside class="surface-panel application-panel" aria-labelledby="application-title">
          <h2 id="application-title">Apply for this role</h2>
          <p class="application-source text-muted">Listed on <strong>{platformLabel}</strong></p>
          {applyHref ? (
            <a href={applyHref} target="_blank" rel={applyRel} class="button button-primary">
              Apply on {platformLabel}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>
            </a>
          ) : (
            <p class="field-note">This listing does not have a safe outbound link.</p>
          )}
          <p class="field-note">Confirm availability, requirements and application instructions in the original listing.</p>
        </aside>

        <div class="detail-content">
          <section aria-labelledby="role-facts-title">
            <h2 id="role-facts-title" class="detail-section-title">Role details</h2>
            <dl class="role-facts">
              <div>
                <dt>Employment type</dt>
                <dd>{typeLabel}</dd>
              </div>
              <div>
                <dt>Work location</dt>
                <dd class="capitalize">{job.locationType ?? 'Not specified in the source'}</dd>
              </div>
              {job.category !== 'other' && (
                <div>
                  <dt>Category</dt>
                  <dd>{categoryTitle(categoryInfo.title)}</dd>
                </div>
              )}
              {job.experienceLevel && job.experienceLevel !== 'any' && (
                <div>
                  <dt>Experience</dt>
                  <dd class="capitalize">{job.experienceLevel}</dd>
                </div>
              )}
              <div>
                <dt>Pay</dt>
                <dd>{job.payRange || 'Not specified in the source'}</dd>
              </div>
              {job.clientTimezone && (
                <div>
                  <dt>Client timezone</dt>
                  <dd>{job.clientTimezone}</dd>
                </div>
              )}
              <div>
                {shiftInfo.category !== 'unknown' ? (
                  <>
                    <dt>Schedule mentioned</dt>
                    <dd>
                      <span class="capitalize">{shiftInfo.category.replaceAll('_', ' ')}</span>
                      <p class="field-note">Confirm exact hours in the original listing.</p>
                    </dd>
                  </>
                ) : (
                  <>
                    <dt>Schedule</dt>
                    <dd>Not specified in the source</dd>
                  </>
                )}
              </div>
              {postedDate && (
                <div>
                  <dt>{postedDateLabel}</dt>
                  <dd><time datetime={displayDateTime ?? undefined}>{postedDate}</time></dd>
                </div>
              )}
              {Array.isArray(job.tags) && job.tags.length > 0 && (
                <div class="role-tags">
                  <dt>Tags</dt>
                  <dd>{(job.tags as string[]).join(' · ')}</dd>
                </div>
              )}
            </dl>
          </section>

          {canShowDescription && displayDescription && (
            <section class="detail-description" aria-labelledby="description-title">
              <h2 id="description-title" class="detail-section-title">About this role</h2>
              <div class="reading-copy">
                <p class="source-excerpt">{displayDescription}{isTruncated ? '...' : ''}</p>
              </div>
              {isTruncated && safeSourceUrl && (
                <a href={safeSourceUrl} target="_blank" rel={applyRel} class="detail-source-link text-link">
                  Read full listing on {platformLabel} ↗
                </a>
              )}
            </section>
          )}

          {!canShowDescription && (
            <section class="detail-description" aria-labelledby="description-title">
              <h2 id="description-title" class="detail-section-title">About this role</h2>
              <p class="reading-copy">Full job details are available on the original listing.</p>
              {safeSourceUrl && (
                <a href={safeSourceUrl} target="_blank" rel={applyRel} class="detail-source-link text-link">
                  View on {platformLabel} ↗
                </a>
              )}
            </section>
          )}
        </div>
      </div>
    </article>
  </section>
</Layout>

<style>
  .job-detail { max-width: 1120px; margin-inline: auto; }
  .detail-back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 20px; font-size: 14px; }
  .detail-heading { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 20px; margin-bottom: 32px; }
  .detail-heading .opportunity-initials { margin-top: 4px; }
  .detail-heading h1 { max-width: 30ch; line-height: 1.25; overflow-wrap: anywhere; }
  .detail-company { margin-top: 8px; color: var(--ink); font-size: 17px; font-weight: 800; overflow-wrap: anywhere; }
  .detail-status { margin-top: 12px; font-size: 13px; }
  .detail-layout { display: grid; gap: 32px; }
  .detail-content { min-width: 0; }
  .detail-section-title { margin-bottom: 16px; font-family: var(--font-display); font-size: 26px; font-weight: 650; }
  .role-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-block: 24px; border-top: 1px solid var(--divider); border-bottom: 1px solid var(--divider); }
  .role-facts dt { margin-bottom: 4px; color: var(--muted); font-size: 13px; font-weight: 500; }
  .role-facts dd { font-size: 15px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  .role-facts time { font-variant-numeric: tabular-nums; }
  .role-tags { grid-column: 1 / -1; }
  .detail-description { margin-top: 40px; }
  .source-excerpt { white-space: pre-line; overflow-wrap: anywhere; }
  .detail-source-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; font-size: 14px; }
  .application-panel { align-self: start; padding: 24px; background: #F4E4CD; }
  .application-panel h2 { font-size: 20px; font-weight: 600; }
  .application-source { margin-top: 8px; font-size: 13px; overflow-wrap: anywhere; }
  .application-source strong { color: var(--ink); font-weight: 600; }
  .application-panel .button { width: 100%; margin-top: 20px; }
  .application-panel svg { width: 16px; height: 16px; flex-shrink: 0; }
  .application-panel .field-note { margin-top: 16px; }
  @media (min-width: 1024px) {
    .detail-layout { grid-template-columns: minmax(0, 1fr) 304px; gap: 48px; }
    .application-panel { position: sticky; top: 88px; grid-column: 2; grid-row: 1; }
    .detail-content { grid-column: 1; grid-row: 1; }
  }
  @media (width < 768px) {
    .job-detail { padding-bottom: calc(24px + var(--safe-bottom)); }
    .detail-back { margin-bottom: 16px; }
    .detail-heading { gap: 12px; margin-bottom: 24px; }
    .detail-heading h1 { font-size: 28px; }
    .application-panel { padding: 20px; }
    .role-facts { gap: 20px 16px; }
  }
</style>
