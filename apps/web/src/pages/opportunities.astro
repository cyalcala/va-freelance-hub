---
import Layout from '../layouts/Layout.astro';
import { getDb, opportunities } from '@va-hub/db';
import { and, asc, count, desc, eq, type SQL, sql } from 'drizzle-orm';
import { OpportunityCard, type OpportunityCardData } from '@/components/opportunity-card';
import { JOB_CATEGORY_MAP } from '@/lib/categories';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { parseJobBoardRequest } from '@/lib/public-query';
import { buildOpportunityFtsQueries } from '@/lib/opportunity-fts-query';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const PAGE_SIZE = 30;
const TYPE_OPTIONS = ['VA', 'freelance', 'project', 'full-time', 'part-time'];
const GEO_SCOPE_OPTIONS = [
  { value: 'ph_only', label: '🇵🇭 PH-exclusive' },
  { value: 'apac_incl_ph', label: '⏰ APAC-friendly' },
  { value: 'worldwide', label: '🌍 Worldwide' },
];

const searchParams = Astro.url.searchParams;
const parsedRequest = parseJobBoardRequest(searchParams);
if (!parsedRequest.ok) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response(parsedRequest.message, { status: parsedRequest.status });
}

const { query, page: currentPage, fresh } = parsedRequest;
const category = searchParams.get('category') || '';
const type = searchParams.get('type') || '';
const platform = searchParams.get('platform') || '';
const geoScope = searchParams.get('geoScope') || '';
const activeFilterCount = [category, type, platform, geoScope, fresh].filter(Boolean).length;
const hasActiveFilters = Boolean(query || activeFilterCount > 0);
const offset = (currentPage - 1) * PAGE_SIZE;

let pageJobs: OpportunityCardData[] = [];
let platformOptions: string[] = [];
let totalJobs = 0;
let dataUnavailable = false;
let pageOutOfRange = false;

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  if (type) params.set('type', type);
  if (platform) params.set('platform', platform);
  if (geoScope) params.set('geoScope', geoScope);
  if (fresh) params.set('fresh', fresh);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/opportunities?${qs}` : '/opportunities';
}

function buildFreshUrl(value: string | null) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  if (type) params.set('type', type);
  if (platform) params.set('platform', platform);
  if (geoScope) params.set('geoScope', geoScope);
  if (value) params.set('fresh', value);
  const qs = params.toString();
  return qs ? `/opportunities?${qs}` : '/opportunities';
}

try {
  const db = getDb(Astro.locals.runtime.env);
  const filters: SQL[] = [eq(opportunities.isActive, true)];

  if (category && JOB_CATEGORY_MAP[category]) {
    filters.push(eq(opportunities.category, category));
  }

  if (type && TYPE_OPTIONS.includes(type)) {
    filters.push(eq(opportunities.type, type));
  }

  if (platform) {
    filters.push(eq(opportunities.sourcePlatform, platform));
  }

  if (geoScope && GEO_SCOPE_OPTIONS.some((opt) => opt.value === geoScope)) {
    filters.push(eq(opportunities.geoScope, geoScope as any));
  }

  // Fresh-arrivals slice: first-seen (`scraped_at`) recency. `today` is the
  // current Asia/Manila calendar day. Absent by default — no behavior change.
  if (fresh === '24h') {
    filters.push(sql`unixepoch(${opportunities.scrapedAt}) >= unixepoch('now') - 86400`);
  } else if (fresh === 'today') {
    filters.push(sql`date(${opportunities.scrapedAt}, '+8 hours') = date('now', '+8 hours')`);
  }

  if (query) {
    const ftsMatch = query
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => `"${w.replace(/"/g, '""')}"`)
      .join(' ');

    const ftsQueries = buildOpportunityFtsQueries({
      ftsMatch,
      category: category && JOB_CATEGORY_MAP[category] ? category : undefined,
      type: type && TYPE_OPTIONS.includes(type) ? type : undefined,
      platform: platform || undefined,
      geoScope: geoScope && GEO_SCOPE_OPTIONS.some((opt) => opt.value === geoScope) ? geoScope : undefined,
      fresh: fresh ?? undefined,
      limit: PAGE_SIZE,
      offset,
    });
    const d1 = Astro.locals.runtime.env.DB;
    const countRow = await d1
      .prepare(ftsQueries.countSql)
      .bind(...ftsQueries.filterParams)
      .first<{ total: number }>();
    totalJobs = countRow?.total ?? 0;

    pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
    if (!pageOutOfRange) {
      const pageResult = await d1
        .prepare(ftsQueries.pageSql)
        .bind(...ftsQueries.pageParams)
        .all<OpportunityCardData>();
      pageJobs = pageResult.results;
    }
  } else {
    const whereClause = and(...filters);

    const [totalResult] = await db
      .select({ total: count() })
      .from(opportunities)
      .where(whereClause);

    totalJobs = totalResult?.total ?? 0;

    pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
    if (!pageOutOfRange) {
      // Fresh view orders by discovery (first-seen); default board keeps the
      // source-posted-date order.
      const freshOrder = fresh
        ? desc(opportunities.scrapedAt)
        : desc(sql`coalesce(${opportunities.postedAt}, ${opportunities.scrapedAt})`);
      pageJobs = await db
        .select()
        .from(opportunities)
        .where(whereClause)
        .orderBy(freshOrder)
        .limit(PAGE_SIZE)
        .offset(offset);
    }
  }

  const platforms = await db
    .select({ name: opportunities.sourcePlatform })
    .from(opportunities)
    .where(eq(opportunities.isActive, true))
    .groupBy(opportunities.sourcePlatform)
    .orderBy(asc(opportunities.sourcePlatform));

  platformOptions = platforms.map((item) => item.name).filter(Boolean);
} catch (e) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, e);
}

if (pageOutOfRange && !dataUnavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Not found', { status: 404 });
}

const totalPages = Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
const hasPrevious = currentPage > 1;
const hasNext = currentPage < totalPages;
const resultStart = totalJobs === 0 ? 0 : offset + 1;
const resultEnd = Math.min(offset + pageJobs.length, totalJobs);
---

<Layout
  title="Browse Remote Jobs for Filipinos — VA & Freelance Hub"
  description="Search and filter every active remote and VA role open to Filipino talent. Updated automatically, all day."
>
  {dataUnavailable && <ServiceUnavailable />}
  <section class="w-full max-w-5xl mx-auto pt-6 sm:pt-10 md:pt-14">
    <div class="mb-5 sm:mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-ink/50 hover:text-accent transition-colors group mb-3 sm:mb-6"
      >
        <span class="inline-block transition-transform group-hover:-translate-x-0.5">&larr;</span>
        Home
      </a>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-overline text-accent mb-1.5 sm:mb-2">The full board</p>
          <div class="flex items-center gap-2.5">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
              Every open remote role
            </h1>
            <span class="sm:hidden text-xs font-semibold text-ink/60 bg-surface border border-ink/[0.09] px-2.5 py-1 rounded-full shrink-0 tabular-nums">
              {totalJobs.toLocaleString()} jobs
            </span>
          </div>
          <p class="text-ink/55 text-sm sm:text-[15px] max-w-xl mt-2 sm:mt-3 leading-relaxed">
            Search, filter, and page through every active opportunity open to
            Filipino remote workers. Every listing is geo-checked for
            Philippine eligibility &mdash; country-locked &ldquo;remote&rdquo;
            jobs are filtered out automatically.
          </p>
        </div>
        <div class="hidden sm:inline-flex text-sm font-semibold text-ink/60 bg-surface border border-ink/[0.09] px-4 py-2 rounded-full self-start sm:self-auto shrink-0 tabular-nums">
          {totalJobs.toLocaleString()} {totalJobs === 1 ? 'job' : 'jobs'}
        </div>
      </div>
    </div>

    <form
      id="search"
      method="get"
      action="/opportunities"
      class="scroll-mt-20 sticky top-[4rem] sm:top-[4.5rem] z-40 mt-5 sm:mt-8 mb-6 sm:mb-8 bg-parchment/90 backdrop-blur-xl border border-ink/[0.08] rounded-2xl p-2 sm:p-2.5 shadow-soft transition-all"
    >
      <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1.5fr)_repeat(4,minmax(0,0.85fr))_auto] gap-2">
        <!-- Hidden peer checkbox for mobile filter disclosure state -->
        <input
          type="checkbox"
          id="filters-expanded"
          class="peer sr-only"
          checked={activeFilterCount > 0 ? true : undefined}
        />

        <!-- Top bar on mobile (search input + filter toggle + search button) / Inline on desktop -->
        <div class="flex items-center gap-2 lg:contents">
          <label class="sr-only" for="q">Search jobs</label>
          <div class="relative flex-1 min-w-0">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink/35 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              id="q"
              type="search"
              name="q"
              value={query}
              placeholder="Search roles, companies, platforms…"
              class="w-full h-11 pl-9 pr-3 bg-surface border border-ink/[0.09] rounded-xl text-sm text-ink font-medium focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/15 transition-all placeholder:text-ink/35"
            />
          </div>

          <!-- Mobile filter toggle button (hidden on desktop) -->
          <label
            for="filters-expanded"
            class={`lg:hidden inline-flex items-center justify-center gap-1.5 h-11 px-3 rounded-xl border text-xs font-semibold cursor-pointer select-none transition-all shrink-0 ${activeFilterCount > 0 ? 'bg-accent/10 border-accent/30 text-accent' : 'bg-surface border-ink/[0.09] text-ink/70 hover:text-ink hover:bg-ink/[0.03]'}`}
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span>Filters</span>
            {activeFilterCount > 0 && (
              <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[10px] font-bold bg-accent text-white tabular-nums">
                {activeFilterCount}
              </span>
            )}
          </label>

          <!-- Search button (always accessible) -->
          <button
            type="submit"
            class="h-11 bg-accent hover:bg-accent-hover text-white px-4 sm:px-5 rounded-xl text-sm font-semibold transition-all shadow-soft hover:shadow-lift shrink-0 active:scale-[0.98] lg:order-last"
          >
            Search
          </button>
        </div>

        <!-- 4 Secondary filters: hidden by default on mobile, 2x2 grid when peer checked, inline grid columns on desktop -->
        <div class="hidden peer-checked:grid grid-cols-2 gap-2 pt-1 lg:pt-0 lg:contents">
          <div class="relative">
            <label class="sr-only" for="category">Category</label>
            <select
              id="category"
              name="category"
              class="w-full h-10 lg:h-11 px-2.5 lg:px-3 bg-surface border border-ink/[0.09] rounded-lg lg:rounded-xl text-xs lg:text-sm text-ink font-medium focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/15 truncate"
            >
              <option value="">All categories</option>
              {Object.entries(JOB_CATEGORY_MAP).map(([key, info]) => (
                <option value={key} selected={category === key}>{info.title}</option>
              ))}
            </select>
          </div>

          <div class="relative">
            <label class="sr-only" for="type">Type</label>
            <select
              id="type"
              name="type"
              class="w-full h-10 lg:h-11 px-2.5 lg:px-3 bg-surface border border-ink/[0.09] rounded-lg lg:rounded-xl text-xs lg:text-sm text-ink font-medium focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/15 truncate"
            >
              <option value="">All types</option>
              {TYPE_OPTIONS.map((option) => (
                <option value={option} selected={type === option}>{option}</option>
              ))}
            </select>
          </div>

          <div class="relative">
            <label class="sr-only" for="platform">Platform</label>
            <select
              id="platform"
              name="platform"
              class="w-full h-10 lg:h-11 px-2.5 lg:px-3 bg-surface border border-ink/[0.09] rounded-lg lg:rounded-xl text-xs lg:text-sm text-ink font-medium focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/15 truncate"
            >
              <option value="">All platforms</option>
              {platformOptions.map((option) => (
                <option value={option} selected={platform === option}>{option}</option>
              ))}
            </select>
          </div>

          <div class="relative">
            <label class="sr-only" for="geoScope">Eligibility</label>
            <select
              id="geoScope"
              name="geoScope"
              class="w-full h-10 lg:h-11 px-2.5 lg:px-3 bg-surface border border-ink/[0.09] rounded-lg lg:rounded-xl text-xs lg:text-sm text-ink font-medium focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/15 truncate"
            >
              <option value="">All geo scopes</option>
              {GEO_SCOPE_OPTIONS.map((option) => (
                <option value={option.value} selected={geoScope === option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </form>

    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[13px] font-semibold text-ink/45">
      <p class="tabular-nums">
        Showing {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {totalJobs.toLocaleString()}
      </p>
      <div class="flex items-center gap-2">
        <span class="text-ink/35 font-medium">New arrivals:</span>
        <a
          href={buildFreshUrl('24h')}
          aria-current={fresh === '24h' ? 'page' : undefined}
          class={`px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors ${fresh === '24h' ? 'bg-accent/10 border-accent/30 text-accent' : 'bg-surface border-ink/[0.09] text-ink/60 hover:text-accent hover:border-accent/30'}`}
        >
          Last 24h
        </a>
        <a
          href={buildFreshUrl('today')}
          aria-current={fresh === 'today' ? 'page' : undefined}
          class={`px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors ${fresh === 'today' ? 'bg-accent/10 border-accent/30 text-accent' : 'bg-surface border-ink/[0.09] text-ink/60 hover:text-accent hover:border-accent/30'}`}
        >
          Today (Manila)
        </a>
        {(query || category || type || platform || geoScope || fresh) && (
          <a href="/opportunities" class="text-accent hover:text-accent-hover transition-colors">
            Clear filters
          </a>
        )}
      </div>
    </div>

    {pageJobs.length === 0 ? (
      <div class="text-center py-24 bg-surface/60 rounded-2xl border border-ink/[0.07]">
        <p class="text-ink/55 font-semibold text-lg">No jobs match these filters.</p>
        <p class="text-ink/40 text-sm mt-1">Try removing a filter or broadening your search.</p>
        <a href="/opportunities" class="inline-flex items-center mt-5 px-4 py-2 rounded-full bg-ink/[0.05] hover:bg-accent-soft text-ink hover:text-accent font-semibold text-sm transition-colors">Reset filters</a>
      </div>
    ) : (
      <div class="bg-surface border border-ink/[0.07] rounded-2xl p-2 sm:p-3 shadow-card flex flex-col divide-y divide-ink/[0.05]">
        {pageJobs.map((opp) => (
          <OpportunityCard opportunity={opp} />
        ))}
      </div>
    )}

    <nav class="mt-8 flex items-center justify-between gap-4" aria-label="Opportunity pagination">
      {hasPrevious ? (
        <a
          href={buildPageUrl(currentPage - 1)}
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-surface border border-ink/[0.09] text-sm font-semibold text-ink/70 hover:text-accent hover:border-accent/30 transition-colors"
        >
          &larr; Previous
        </a>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-ink/[0.03] border border-ink/[0.05] text-sm font-semibold text-ink/25">
          &larr; Previous
        </span>
      )}

      <span class="text-[13px] font-semibold text-ink/45 tabular-nums">
        Page {currentPage.toLocaleString()} of {totalPages.toLocaleString()}
      </span>

      {hasNext ? (
        <a
          href={buildPageUrl(currentPage + 1)}
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-surface border border-ink/[0.09] text-sm font-semibold text-ink/70 hover:text-accent hover:border-accent/30 transition-colors"
        >
          Next &rarr;
        </a>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-ink/[0.03] border border-ink/[0.05] text-sm font-semibold text-ink/25">
          Next &rarr;
        </span>
      )}
    </nav>
  </section>
</Layout>
