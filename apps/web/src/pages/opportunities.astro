---
import Layout from '../layouts/Layout.astro';
import { OpportunityCard, type OpportunityCardData } from '@/components/opportunity-card';
import { JOB_CATEGORY_MAP, parseJobCategory } from '@/lib/categories';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { publicPlatforms, slicePublicJobs } from '@/lib/public-board';
import { applySnapshotHeaders, loadPublicBoard } from '@/lib/public-serving-snapshot';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { parseJobBoardRequest } from '@/lib/public-query';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const PAGE_SIZE = 30;
const TYPE_OPTIONS = ['VA', 'freelance', 'project', 'full-time', 'part-time'];
const TYPE_LABELS: Record<string, string> = {
  VA: 'VA', freelance: 'Freelance', project: 'Project', 'full-time': 'Full-time', 'part-time': 'Part-time',
};
const GEO_SCOPE_OPTIONS = [
  { value: 'ph_only', label: 'Philippines' },
  { value: 'apac_incl_ph', label: 'APAC incl. PH' },
  { value: 'worldwide', label: 'Worldwide' },
];

const searchParams = Astro.url.searchParams;
const parsedRequest = parseJobBoardRequest(searchParams);
if (!parsedRequest.ok) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response(parsedRequest.message, { status: parsedRequest.status });
}

const { query, page: currentPage, fresh } = parsedRequest;
const category = searchParams.get('category') || '';
const selectedCategory = parseJobCategory(category);
const type = searchParams.get('type') || '';
const platform = searchParams.get('platform') || '';
const geoScope = searchParams.get('geoScope') || '';
const activeFilterCount = [category, type, platform, geoScope, fresh].filter(Boolean).length;
const hasActiveFilters = Boolean(query || activeFilterCount > 0);
const offset = (currentPage - 1) * PAGE_SIZE;

let pageJobs: OpportunityCardData[] = [];
let platformOptions: string[] = [];
let totalJobs = 0;
let dataUnavailable = false;
let pageOutOfRange = false;

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  if (type) params.set('type', type);
  if (platform) params.set('platform', platform);
  if (geoScope) params.set('geoScope', geoScope);
  if (fresh) params.set('fresh', fresh);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/opportunities?${qs}` : '/opportunities';
}

function buildFilterRemovalUrl(key: string) {
  const params = new URLSearchParams(buildPageUrl(1).split('?')[1] ?? '');
  params.delete(key);
  const qs = params.toString();
  return qs ? `/opportunities?${qs}` : '/opportunities';
}

const activeFilters = [
  { key: 'q', value: query, label: `Search: ${query}` },
  { key: 'category', value: category, label: `Category: ${selectedCategory?.title.toLowerCase() ?? category}` },
  { key: 'type', value: type, label: `Type: ${TYPE_LABELS[type] ?? type}` },
  { key: 'platform', value: platform, label: `Source: ${platform}` },
  { key: 'geoScope', value: geoScope, label: `Scope: ${GEO_SCOPE_OPTIONS.find((option) => option.value === geoScope)?.label ?? geoScope}` },
  { key: 'fresh', value: fresh, label: `Arrivals: ${fresh === 'today' ? 'Today (Manila)' : 'Last 24 hours'}` },
].filter((filter) => filter.value);

try {
  const board = await loadPublicBoard(Astro.locals.runtime.env, Astro.locals.runtime.ctx);
  applySnapshotHeaders(Astro.response.headers);
  platformOptions = publicPlatforms(board.jobs);
  const sliced = slicePublicJobs(board.jobs, {
    category: selectedCategory ? selectedCategory.slug : undefined,
    type: type && TYPE_OPTIONS.includes(type) ? type : undefined,
    platform: platform || undefined,
    geoScope: geoScope && GEO_SCOPE_OPTIONS.some((option) => option.value === geoScope) ? geoScope : undefined,
    fresh,
    query,
    offset,
    limit: PAGE_SIZE,
  });
  totalJobs = sliced.total;
  pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
  if (!pageOutOfRange) pageJobs = sliced.jobs;
} catch (e) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, e);
}

if (pageOutOfRange && !dataUnavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Not found', { status: 404 });
}

const totalPages = Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
const hasPrevious = currentPage > 1;
const hasNext = currentPage < totalPages;
const resultStart = totalJobs === 0 ? 0 : offset + 1;
const resultEnd = Math.min(offset + pageJobs.length, totalJobs);
---

<Layout
  title="Remote Jobs for Filipinos — VA & Freelance Hub"
  description="Search remote and VA opportunities, compare their available facts, and follow the original source listing."
>
  <section class="page-section">
    <div class="page-heading">
      <h1 class="page-title">Find your next opportunity</h1>
      <p class="page-description">
        Search remote roles for Filipino professionals. Compare the available facts,
        then review the original listing.
      </p>
    </div>

    <form id="search" method="get" action="/opportunities" class="board-search">
      <div class="board-search-label">
        <label for="q" class="field-label">Role, company or keyword</label>
        <span class="search-shortcut">Press <kbd>/</kbd> to search</span>
      </div>
      <div class="board-search-row">
        <div class="board-search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
          <input id="q" type="search" name="q" value={query} placeholder="Search all opportunities" class="field-input" />
        </div>
        <button type="submit" class="button button-primary">Search</button>
      </div>
    </form>

    <div class="board-shell">
      <aside class="filter-rail" aria-label="Job filters">
        <h2 class="filter-heading">Refine your search</h2>
        <details class="filter-disclosure" id="job-filters" open data-active-filters={activeFilterCount > 0 ? 'true' : 'false'}>
          <summary>Filters{activeFilterCount > 0 && <span class="text-muted"> · {activeFilterCount} active</span>}</summary>
          <div class="filter-fields">
            <div>
              <label for="category" class="field-label">Category</label>
              <select id="category" name="category" form="search" class="field-select">
                <option value="">All categories</option>
                {Object.entries(JOB_CATEGORY_MAP).map(([slug, info]) => (
                  <option value={slug} selected={category === slug}>{info.title.toLowerCase().replace(/\b\w/g, (letter) => letter.toUpperCase())}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="type" class="field-label">Employment type</label>
              <select id="type" name="type" form="search" class="field-select">
                <option value="">All types</option>
                {TYPE_OPTIONS.map((option) => (
                  <option value={option} selected={type === option}>{TYPE_LABELS[option]}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="platform" class="field-label">Source</label>
              <select id="platform" name="platform" form="search" class="field-select">
                <option value="">All sources</option>
                {platformOptions.map((option) => (
                  <option value={option} selected={platform === option}>{option}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="geoScope" class="field-label">Geographic scope</label>
              <select id="geoScope" name="geoScope" form="search" class="field-select">
                <option value="">All scopes</option>
                {GEO_SCOPE_OPTIONS.map((option) => (
                  <option value={option.value} selected={geoScope === option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="fresh" class="field-label">New arrivals</label>
              <select id="fresh" name="fresh" form="search" aria-describedby="arrivals-note" class="field-select">
                <option value="" selected={!fresh}>Any time</option>
                <option value="24h" selected={fresh === '24h'}>Last 24 hours</option>
                <option value="today" selected={fresh === 'today'}>Today (Manila)</option>
              </select>
              <p id="arrivals-note" class="field-note">When first seen by the index, separate from the source posted date.</p>
            </div>
          </div>
          <div class="filter-actions">
            <button type="submit" form="search" class="button button-secondary">Apply filters</button>
            {hasActiveFilters && <a href="/opportunities" class="filter-reset text-link">Clear all</a>}
          </div>
        </details>
      </aside>

      <div class="board-results">
        {hasActiveFilters && (
          <nav class="active-filters" aria-label="Active filters">
            {activeFilters.map((filter) => (
              <a href={buildFilterRemovalUrl(filter.key)} class="active-filter" aria-label={`Remove ${filter.label}`}>
                <span>{filter.label}</span>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8"/></svg>
              </a>
            ))}
            <a href="/opportunities" class="filter-reset text-link">Clear all</a>
          </nav>
        )}
        {dataUnavailable ? (
          <ServiceUnavailable />
        ) : (
          <>
            <div class="results-summary">
              <strong>{totalJobs.toLocaleString()} {totalJobs === 1 ? 'opportunity' : 'opportunities'}</strong>
              <p>Showing {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {totalJobs.toLocaleString()}</p>
            </div>

            {pageJobs.length === 0 ? (
              <div class="surface-panel empty-state">
                <h2>{hasActiveFilters ? 'No jobs match this search' : 'No listings to show right now'}</h2>
                <p>{hasActiveFilters ? 'Try a broader keyword or remove a filter to see more opportunities.' : 'Please check back later for available opportunities.'}</p>
                {hasActiveFilters && <a href="/opportunities" class="button button-secondary">Reset filters</a>}
              </div>
            ) : (
              <div class="result-list">
                {pageJobs.map((opp) => <OpportunityCard opportunity={opp} />)}
              </div>
            )}

            <nav class="pagination" aria-label="Opportunity pagination">
              {hasPrevious ? (
                <a href={buildPageUrl(currentPage - 1)} class="pagination-control">&larr; Previous</a>
              ) : (
                <span class="pagination-control" aria-disabled="true">&larr; Previous</span>
              )}
              <span class="text-muted">Page {currentPage.toLocaleString()} of {totalPages.toLocaleString()}</span>
              {hasNext ? (
                <a href={buildPageUrl(currentPage + 1)} class="pagination-control">Next &rarr;</a>
              ) : (
                <span class="pagination-control" aria-disabled="true">Next &rarr;</span>
              )}
            </nav>
          </>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  const filters = document.querySelector<HTMLDetailsElement>('#job-filters');
  const desktop = window.matchMedia('(min-width: 1024px)');
  if (filters) {
    const setFilterLayout = () => {
      filters.open = desktop.matches || filters.dataset.activeFilters === 'true';
    };
    setFilterLayout();
    desktop.addEventListener('change', setFilterLayout);
  }

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
    if (event.target instanceof Element && event.target.closest('input, select, textarea, [contenteditable]:not([contenteditable="false"])')) return;
    const search = document.querySelector<HTMLInputElement>('#q');
    if (search) {
      event.preventDefault();
      search.focus();
    }
  });
</script>
