---
import Layout from '../../layouts/Layout.astro';
import { OpportunityCard } from '@/components/opportunity-card';
import { parseJobCategory } from '@/lib/categories';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { slicePublicJobs, type PublicJob } from '@/lib/public-board';
import { applySnapshotHeaders, loadPublicBoard } from '@/lib/public-serving-snapshot';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { parsePageRequest } from '@/lib/public-query';
import { companyLogoDomains, withCompanyLogo } from '@/lib/company-identity';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const { category } = Astro.params;

// Own-property guard, before any D1 / board load:
const info = parseJobCategory(category);
if (!info) {
  return Astro.redirect('/');
}

const PAGE_SIZE = 30;
const parsedPage = parsePageRequest(Astro.url.searchParams.get('page'));
if (!parsedPage.ok) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response(parsedPage.message, { status: parsedPage.status });
}
const currentPage = parsedPage.page;
const offset = (currentPage - 1) * PAGE_SIZE;

let categoryJobs: (PublicJob & { logoDomain: string | null })[] = [];
let totalJobs = 0;
let dataUnavailable = false;
let pageOutOfRange = false;

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/categories/${info.slug}?${qs}` : `/categories/${info.slug}`;
}

try {
  const board = await loadPublicBoard(Astro.locals.runtime.env, Astro.locals.runtime.ctx);
  applySnapshotHeaders(Astro.response.headers);
  const sliced = slicePublicJobs(board.jobs, {
    category: info.slug,
    offset,
    limit: PAGE_SIZE,
  });
  totalJobs = sliced.total;
  pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
  if (!pageOutOfRange) {
    const domains = companyLogoDomains(board.directory);
    categoryJobs = sliced.jobs.map((job) => withCompanyLogo(job, domains));
  }
} catch (e) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, e);
}

if (pageOutOfRange && !dataUnavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Not found', { status: 404 });
}

const totalPages = Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
const hasPrevious = currentPage > 1;
const hasNext = currentPage < totalPages;
const resultStart = totalJobs === 0 ? 0 : offset + 1;
const resultEnd = Math.min(offset + categoryJobs.length, totalJobs);
const categoryTitle = info.title.replace(/\b[A-Z]+\b/g, (word) =>
  word === 'AI' || word === 'IT' ? word : word[0] + word.slice(1).toLowerCase()
);

---

<Layout
  title={`${categoryTitle} Remote Jobs — VA & Freelance Hub`}
  description={`Explore ${categoryTitle.toLowerCase()} listings in the public board. Compare the company, source and available location evidence, then review the original listing.`}
>
  <section class="page-section">
    <a href="/#categories" class="category-backlink text-muted"><span aria-hidden="true">←</span> All categories</a>
    <div class="page-heading category-heading">
      <div>
        <h1 class="page-title">{categoryTitle}</h1>
        <p class="page-description">
          Explore remote and VA listings in this field. Compare the available facts,
          then review the original listing.
        </p>
      </div>
      <a href={`/opportunities?category=${info.slug}#search`} class="button button-secondary category-search-link">Search this category</a>
    </div>

    {dataUnavailable ? <ServiceUnavailable /> : <>
      <div class="results-summary">
        <p><strong>{totalJobs.toLocaleString()} {totalJobs === 1 ? 'job' : 'jobs'}</strong></p>
        <p>Showing {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {totalJobs.toLocaleString()}</p>
      </div>

      {categoryJobs.length === 0 ? (
        <div class="surface-panel empty-state">
          <h2>No listings in this category.</h2>
          <p>Try another category or browse all opportunities.</p>
          <a href="/opportunities" class="button button-secondary">Browse all jobs</a>
        </div>
      ) : (
        <div class="result-list">
          {categoryJobs.map((opportunity) => <OpportunityCard opportunity={opportunity} />)}
        </div>
      )}

      <nav class="pagination" aria-label={`${categoryTitle} pagination`}>
        {hasPrevious ? (
          <a href={buildPageUrl(currentPage - 1)} class="pagination-control">← Previous</a>
        ) : (
          <span class="pagination-control" aria-disabled="true">← Previous</span>
        )}
        <span class="text-muted">Page {currentPage.toLocaleString()} of {totalPages.toLocaleString()}</span>
        {hasNext ? (
          <a href={buildPageUrl(currentPage + 1)} class="pagination-control">Next →</a>
        ) : (
          <span class="pagination-control" aria-disabled="true">Next →</span>
        )}
      </nav>
    </>}
  </section>
</Layout>

<style>
  .category-backlink { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-bottom: 16px; font-size: 14px; font-weight: 500; transition: color 160ms; }
  .category-backlink:hover { color: var(--accent); }
  .category-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; }
  .category-search-link { flex-shrink: 0; }
</style>
