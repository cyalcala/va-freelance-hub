---
import Layout from '../layouts/Layout.astro';
import DirectoryAgencyCard from '@/components/DirectoryAgencyCard.astro';
import DirectoryCategoryNav from '@/components/DirectoryCategoryNav.astro';
import { getDb, vaDirectory } from '@va-hub/db';
import { and, asc, count, eq, sql, type SQL } from 'drizzle-orm';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { escapeSqlLike, parseJobBoardRequest } from '@/lib/public-query';
import { directoryVisibilityFilters } from '@/lib/directory-visibility';
import {
  DIRECTORY_CATEGORY_INFO,
  DIRECTORY_NICHES,
  isDirectoryNiche,
  parseDirectoryCategory,
  type DirectoryCategory,
} from '@/lib/directory-categories';
import { sanitizeSourceUrl } from '@va-hub/scraper';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const DIRECTORY_PAGE_SIZE = 48;
const parsedRequest = parseJobBoardRequest(Astro.url.searchParams);
if (!parsedRequest.ok) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response(parsedRequest.message, { status: parsedRequest.status });
}

const { query, page: currentPage } = parsedRequest;
const rawCategory = Astro.url.searchParams.get('category');
const selectedCategory = parseDirectoryCategory(rawCategory);
if (rawCategory && !selectedCategory) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Unknown directory category.', { status: 400 });
}
const offset = (currentPage - 1) * DIRECTORY_PAGE_SIZE;

type DirectoryAgency = {
  id: number;
  companyName: string;
  website: string | null;
  niche: string;
  isDayshift: boolean;
  isVerified: boolean;
  isRemote: boolean;
  isMarketplace: boolean;
};

function normalizeDirectoryUrl(raw: string | null): string | null {
  if (!raw) return null;
  return sanitizeSourceUrl(raw) ?? sanitizeSourceUrl(`https://${raw.trim().replace(/^\/\//, '')}`);
}

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (selectedCategory) params.set('category', selectedCategory);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/directory?${qs}` : '/directory';
}

let agencies: DirectoryAgency[] = [];
let totalAgencies = 0;
let dataUnavailable = false;
let pageOutOfRange = false;

try {
  const db = getDb(Astro.locals.runtime.env);
  const filters: SQL[] = [directoryVisibilityFilters()];
  if (selectedCategory === 'dayshift') {
    filters.push(eq(vaDirectory.isDayshift, true));
  } else if (selectedCategory === 'marketplaces') {
    filters.push(eq(vaDirectory.isMarketplace, true));
  } else if (selectedCategory && isDirectoryNiche(selectedCategory)) {
    filters.push(eq(vaDirectory.niche, selectedCategory));
  }
  if (query) {
    filters.push(sql`lower(${vaDirectory.companyName}) LIKE ${`%${escapeSqlLike(query.toLowerCase())}%`} ESCAPE '\\'`);
  }
  const whereClause = and(...filters);

  const [totalResult] = await db
    .select({ total: count() })
    .from(vaDirectory)
    .where(whereClause);
  totalAgencies = totalResult?.total ?? 0;
  pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalAgencies / DIRECTORY_PAGE_SIZE));

  if (!pageOutOfRange) {
    agencies = await db
      .select({
        id: vaDirectory.id,
        companyName: vaDirectory.companyName,
        website: vaDirectory.website,
        niche: vaDirectory.niche,
        isDayshift: vaDirectory.isDayshift,
        isVerified: vaDirectory.isVerified,
        isRemote: vaDirectory.isRemote,
        isMarketplace: vaDirectory.isMarketplace,
      })
      .from(vaDirectory)
      .where(whereClause)
      .orderBy(asc(vaDirectory.companyName))
      .limit(DIRECTORY_PAGE_SIZE)
      .offset(offset);
  }
} catch (error) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, error);
}

if (pageOutOfRange && !dataUnavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Not found', { status: 404 });
}

const totalPages = Math.max(1, Math.ceil(totalAgencies / DIRECTORY_PAGE_SIZE));
const resultStart = totalAgencies === 0 ? 0 : offset + 1;
const resultEnd = Math.min(offset + agencies.length, totalAgencies);
const cards = agencies.map((agency) => {
  const href = normalizeDirectoryUrl(agency.website);
  return { ...agency, href };
});

type DirectoryCard = (typeof cards)[number];
type DirectoryGroup = {
  key: DirectoryCategory;
  cards: DirectoryCard[];
};

const groupedCards: DirectoryGroup[] = selectedCategory
  ? [{ key: selectedCategory, cards }]
  : DIRECTORY_NICHES.map((niche) => ({
      key: niche,
      cards: cards.filter((agency) => agency.niche === niche),
    })).filter((group) => group.cards.length > 0);

const selectedInfo = selectedCategory ? DIRECTORY_CATEGORY_INFO[selectedCategory] : null;

function buildCategoryUrl(category: DirectoryCategory | null) {
  const params = new URLSearchParams();
  if (category) params.set('category', category);
  const qs = params.toString();
  return qs ? `/directory?${qs}` : '/directory';
}

function buildClearSearchUrl() {
  return selectedCategory ? buildCategoryUrl(selectedCategory) : '/directory';
}
---

<Layout
  title="Agencies & Companies That Hire Filipinos — VA & Freelance Hub"
  description="A curated, vetted directory of VA agencies and remote-first companies that actively hire Filipino talent."
>
  {dataUnavailable && <ServiceUnavailable />}
  <div class="max-w-5xl mx-auto pt-12 md:pt-16">
    <div class="mb-9 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-overline text-accent mb-2">The directory</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
        Companies that hire Filipinos
      </h1>
      <p class="mt-3 text-[15px] sm:text-base text-ink/55 leading-relaxed">
        Start with the kind of work or schedule you want. Every visible entry is
        known to hire in the Philippines; job platforms are separated from direct employers.
      </p>
    </div>

    <DirectoryCategoryNav selectedCategory={selectedCategory} />

    <form
      id="search"
      method="get"
      action="/directory"
      class="scroll-mt-20 sticky top-[4.5rem] z-40 max-w-2xl mb-8 bg-parchment/85 backdrop-blur-xl rounded-full"
    >
      {selectedCategory && <input type="hidden" name="category" value={selectedCategory} />}
      <label class="sr-only" for="q">Search companies</label>
      <div class="flex gap-2 rounded-full border border-ink/[0.1] bg-surface p-1.5 shadow-soft focus-within:border-accent/50 focus-within:ring-4 focus-within:ring-accent/10 transition-all">
        <svg class="ml-3 shrink-0 self-center h-5 w-5 text-ink/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          id="q"
          name="q"
          type="search"
          value={query}
          placeholder={selectedInfo ? `Search ${selectedInfo.shortTitle.toLowerCase()}…` : 'Search companies…'}
          class="min-w-0 flex-1 h-11 bg-transparent text-ink text-base font-medium outline-none placeholder:text-ink/35"
        />
        <button type="submit" class="shrink-0 rounded-full bg-accent px-4 sm:px-5 text-sm font-semibold text-white hover:bg-accent-hover transition-colors">Search</button>
      </div>
    </form>

    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 text-[13px] font-semibold text-ink/45">
      <p class="tabular-nums">
        Showing {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {totalAgencies.toLocaleString()}
        {selectedInfo ? ` in ${selectedInfo.shortTitle}` : ' companies'}
      </p>
      {(query || selectedCategory) && (
        <div class="flex items-center gap-3">
          {query && <a href={buildClearSearchUrl()} class="text-accent hover:text-accent-hover transition-colors">Clear search</a>}
          {selectedCategory && <a href="/directory" class="text-ink/50 hover:text-accent transition-colors">Clear category</a>}
        </div>
      )}
    </div>

    {cards.length === 0 ? (
      <div class="text-center py-24 bg-surface/60 rounded-2xl border border-ink/[0.07]">
        <p class="text-ink/55 font-semibold text-lg">{query ? `No companies match “${query}”.` : 'No companies are available right now.'}</p>
        {(query || selectedCategory) && <a href="/directory" class="mt-5 inline-flex items-center px-4 py-2 rounded-full bg-ink/[0.05] hover:bg-accent-soft text-ink hover:text-accent font-semibold text-sm transition-colors">Clear filters</a>}
      </div>
    ) : (
      <div class="space-y-10">
        {groupedCards.map((group) => {
          const info = DIRECTORY_CATEGORY_INFO[group.key];
          return (
          <section aria-labelledby={`directory-group-${group.key}`}>
            <div class="mb-4 border-b border-ink/[0.08] pb-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 id={`directory-group-${group.key}`} class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight text-ink">
                  <span class={`h-2 w-2 rounded-full ${info.dot}`} aria-hidden="true"></span>
                  {info.title}
                </h2>
                {!selectedCategory && (
                  <a href={buildCategoryUrl(group.key)} class="text-sm font-semibold text-accent hover:text-accent-hover">View this category →</a>
                )}
              </div>
              <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink/50">{info.description}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
              {group.cards.map((agency) => <DirectoryAgencyCard agency={agency} />)}
            </div>
          </section>
          );
        })}
      </div>
    )}

    <nav class="mt-8 flex items-center justify-between gap-4" aria-label="Directory pagination">
      {currentPage > 1 ? <a href={buildPageUrl(currentPage - 1)} class="inline-flex items-center px-4 py-2 rounded-full bg-ink/[0.05] hover:bg-accent-soft text-ink hover:text-accent font-semibold text-sm transition-colors">← Previous</a> : <span />}
      <p class="text-sm font-semibold text-ink/45 tabular-nums">Page {currentPage} of {totalPages}</p>
      {currentPage < totalPages ? <a href={buildPageUrl(currentPage + 1)} class="inline-flex items-center px-4 py-2 rounded-full bg-ink/[0.05] hover:bg-accent-soft text-ink hover:text-accent font-semibold text-sm transition-colors">Next →</a> : <span />}
    </nav>
  </div>
</Layout>
