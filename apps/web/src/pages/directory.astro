---
import Layout from '../layouts/Layout.astro';
import DirectoryAgencyCard from '@/components/DirectoryAgencyCard.astro';
import DirectoryCategoryNav from '@/components/DirectoryCategoryNav.astro';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { sliceDirectory, type PublicDirectoryRow } from '@/lib/public-board';
import { applySnapshotHeaders, loadPublicBoard } from '@/lib/public-serving-snapshot';
import { markPublicDataUnavailable } from '@/lib/public-route-load';
import { parseJobBoardRequest } from '@/lib/public-query';
import {
  DIRECTORY_CATEGORY_INFO,
  DIRECTORY_NICHES,
  parseDirectoryCategory,
  type DirectoryCategory,
} from '@/lib/directory-categories';
import { sanitizeSourceUrl } from '@va-hub/scraper';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const DIRECTORY_PAGE_SIZE = 48;
const parsedRequest = parseJobBoardRequest(Astro.url.searchParams);
if (!parsedRequest.ok) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response(parsedRequest.message, { status: parsedRequest.status });
}

const { query, page: currentPage } = parsedRequest;
const rawCategory = Astro.url.searchParams.get('category');
const selectedCategory = parseDirectoryCategory(rawCategory);
if (rawCategory && !selectedCategory) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Unknown directory category.', { status: 400 });
}
const offset = (currentPage - 1) * DIRECTORY_PAGE_SIZE;

type DirectoryAgency = PublicDirectoryRow;

function normalizeDirectoryUrl(raw: string | null): string | null {
  if (!raw) return null;
  return sanitizeSourceUrl(raw) ?? sanitizeSourceUrl(`https://${raw.trim().replace(/^\/\//, '')}`);
}

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (selectedCategory) params.set('category', selectedCategory);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/directory?${qs}` : '/directory';
}

let agencies: DirectoryAgency[] = [];
let totalAgencies = 0;
let dataUnavailable = false;
let pageOutOfRange = false;

try {
  const board = await loadPublicBoard(Astro.locals.runtime.env, Astro.locals.runtime.ctx);
  applySnapshotHeaders(Astro.response.headers);
  const sliced = sliceDirectory(board.directory, {
    query,
    category: selectedCategory,
    offset,
    limit: DIRECTORY_PAGE_SIZE,
  });
  totalAgencies = sliced.total;
  pageOutOfRange = currentPage > Math.max(1, Math.ceil(totalAgencies / DIRECTORY_PAGE_SIZE));
  if (!pageOutOfRange) agencies = sliced.rows;
} catch (error) {
  dataUnavailable = true;
  markPublicDataUnavailable(Astro.response, error);
}

if (pageOutOfRange && !dataUnavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return new Response('Not found', { status: 404 });
}

const totalPages = Math.max(1, Math.ceil(totalAgencies / DIRECTORY_PAGE_SIZE));
const resultStart = totalAgencies === 0 ? 0 : offset + 1;
const resultEnd = Math.min(offset + agencies.length, totalAgencies);
const cards = agencies.map((agency) => {
  const href = normalizeDirectoryUrl(agency.website);
  let logoDomain: string | null = null;
  try {
    logoDomain = href ? new URL(href).hostname : null;
  } catch {}
  return { ...agency, href, logoDomain };
});

type DirectoryCard = (typeof cards)[number];
type DirectoryGroup = {
  key: DirectoryCategory;
  cards: DirectoryCard[];
};

const groupedCards: DirectoryGroup[] = selectedCategory
  ? [{ key: selectedCategory, cards }]
  : DIRECTORY_NICHES.map((niche) => ({
      key: niche,
      cards: cards.filter((agency) => agency.niche === niche),
    })).filter((group) => group.cards.length > 0);

const selectedInfo = selectedCategory ? DIRECTORY_CATEGORY_INFO[selectedCategory] : null;

function buildCategoryUrl(category: DirectoryCategory | null) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  const qs = params.toString();
  return qs ? `/directory?${qs}` : '/directory';
}

function buildClearSearchUrl() {
  return selectedCategory ? `/directory?category=${encodeURIComponent(selectedCategory)}` : '/directory';
}
---

<Layout
  title="Agencies & Companies That Hire Filipinos — VA & Freelance Hub"
  description="Search our directory of VA agencies, remote employers and job platforms that hire Filipino talent."
>
  <section class="page-section">
    <div class="page-heading">
      <h1 class="page-title">Companies that hire Filipinos</h1>
      <p class="page-description">
        Search VA agencies, remote employers and job platforms. Browse by work
        category or find a company by name.
      </p>
    </div>

    <form id="search" method="get" action="/directory" class="board-search directory-search">
      {selectedCategory && <input type="hidden" name="category" value={selectedCategory} />}
      <label class="field-label" for="q">Search companies</label>
      <div class="board-search-row">
        <div class="board-search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            id="q"
            name="q"
            type="search"
            value={query}
            placeholder={selectedInfo ? `Search ${selectedInfo.shortTitle.toLowerCase()}…` : 'Company or agency name…'}
            class="field-input"
          />
        </div>
        <button type="submit" class="button button-primary">Search</button>
      </div>
    </form>

    <DirectoryCategoryNav selectedCategory={selectedCategory} query={query} />

    {(query || selectedCategory) && (
      <nav class="directory-resets" aria-label="Active directory filters">
        {query && <a href={buildClearSearchUrl()} class="text-link">Clear search</a>}
        {selectedCategory && <a href={buildCategoryUrl(null)} class="text-link">Clear category</a>}
        <a href="/directory" class="text-link">Reset filters</a>
      </nav>
    )}

    {dataUnavailable ? (
      <ServiceUnavailable />
    ) : (
      <>
        <div class="results-summary">
          <strong>{totalAgencies.toLocaleString()} {totalAgencies === 1 ? 'directory entry' : 'directory entries'}{selectedInfo ? ` in ${selectedInfo.shortTitle}` : ''}</strong>
          <p>Showing {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {totalAgencies.toLocaleString()}</p>
        </div>

        {cards.length === 0 ? (
          <div class="surface-panel empty-state">
            <h2>{query ? `No companies match “${query}”` : selectedCategory ? 'No companies in this category right now' : 'No companies to show right now'}</h2>
            <p>{query || selectedCategory ? 'Try a broader company name or remove a category to see more entries.' : 'Please check back later for available directory entries.'}</p>
            {(query || selectedCategory) && <a href="/directory" class="button button-secondary">Reset filters</a>}
          </div>
        ) : (
          <div class="directory-groups">
            {groupedCards.map((group) => {
              const info = DIRECTORY_CATEGORY_INFO[group.key];
              return (
                <section aria-labelledby={`directory-group-${group.key}`}>
                  <div class="directory-group-heading">
                    <div>
                      <h2 id={`directory-group-${group.key}`}>{info.title}</h2>
                      <p class="text-muted">{info.description}</p>
                    </div>
                    {!selectedCategory && (
                      <a href={buildCategoryUrl(group.key)} class="text-link">View this category →</a>
                    )}
                  </div>
                  <div class="result-list">
                    {group.cards.map((agency) => <DirectoryAgencyCard agency={agency} />)}
                  </div>
                </section>
              );
            })}
          </div>
        )}

        <nav class="pagination" aria-label="Directory pagination">
          {currentPage > 1 ? (
            <a href={buildPageUrl(currentPage - 1)} class="pagination-control">← Previous</a>
          ) : (
            <span class="pagination-control" aria-disabled="true">← Previous</span>
          )}
          <span class="text-muted">Page {currentPage.toLocaleString()} of {totalPages.toLocaleString()}</span>
          {currentPage < totalPages ? (
            <a href={buildPageUrl(currentPage + 1)} class="pagination-control">Next →</a>
          ) : (
            <span class="pagination-control" aria-disabled="true">Next →</span>
          )}
        </nav>
      </>
    )}
  </section>
</Layout>

<style>
  .directory-search { max-width: 880px; }
  .directory-resets { display: flex; flex-wrap: wrap; gap: 4px 24px; margin-bottom: 16px; font-size: 13px; }
  .directory-resets a { display: inline-flex; align-items: center; min-height: 44px; }
  .directory-groups { display: grid; gap: 40px; }
  .directory-group-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 8px 24px; margin-bottom: 16px; }
  .directory-group-heading > div { flex: 1; min-width: min(100%, 280px); }
  .directory-group-heading h2 { font-size: 22px; font-weight: 600; }
  .directory-group-heading p { max-width: 70ch; margin-top: 8px; font-size: 14px; line-height: 1.6; }
  .directory-group-heading > a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; }
  @media (width < 768px) {
    .directory-search .board-search-row { gap: 8px; }
    .directory-search .button { padding-inline: 16px; }
  }
</style>
