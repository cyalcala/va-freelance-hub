---
type Props = {
  agency: {
    companyName: string;
    href: string | null;
    logoDomain: string | null;
    isVerified: boolean;
    isDayshift: boolean;
    isRemote: boolean;
    isMarketplace: boolean;
  };
};

const { agency } = Astro.props;
const initial = agency.companyName.charAt(0).toUpperCase();
const logoUrl = agency.logoDomain
  ? `/api/company-logo?domain=${encodeURIComponent(agency.logoDomain)}&initial=${encodeURIComponent(initial)}`
  : null;
const Row = agency.href ? 'a' : 'div';
---

<article>
  <Row
    href={agency.href ?? undefined}
    target={agency.href ? '_blank' : undefined}
    rel={agency.href ? 'noopener noreferrer' : undefined}
    class="directory-row"
  >
    <div class="directory-logo" aria-hidden="true">
      <span>{initial}</span>
      {logoUrl && (
        <img
          src={logoUrl}
          alt=""
          aria-hidden="true"
          width="24"
          height="24"
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
    <div class="directory-company">
      <h3>{agency.companyName}</h3>
      <div class="directory-attributes text-muted">
        {agency.isVerified && <span>Verified company</span>}
        {agency.isDayshift && <span>Dayshift</span>}
        {agency.isRemote && <span>Remote</span>}
        {agency.isMarketplace && <span>Marketplace</span>}
        {!agency.href && <span>Website unavailable</span>}
      </div>
    </div>
    {agency.href && <span class="directory-visit text-muted">
      <span>Visit website</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h6"/></svg>
    </span>}
  </Row>
</article>

<style>
  .directory-row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 16px; min-height: 80px; padding: 16px 24px; transition: background-color 160ms; }
  a.directory-row:hover { background: var(--page); }
  a.directory-row:focus-visible { outline-offset: -3px; }
  .directory-logo { position: relative; display: grid; place-items: center; width: 40px; height: 40px; overflow: hidden; border: 1px solid var(--divider); border-radius: 6px; color: var(--muted); background: var(--recessed); font-size: 13px; font-weight: 600; }
  .directory-logo img { position: absolute; inset: 0; width: 24px; height: 24px; margin: auto; object-fit: contain; }
  .directory-company { min-width: 0; }
  h3 { font-size: 17px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; transition: color 160ms; }
  a.directory-row:hover h3 { color: var(--accent); }
  .directory-attributes { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 4px; font-size: 13px; line-height: 1.5; }
  .directory-visit { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .directory-visit svg { width: 16px; height: 16px; flex-shrink: 0; }
  @media (width < 768px) {
    .directory-row { gap: 12px; padding: 16px; }
    .directory-visit > span { display: none; }
  }
</style>
