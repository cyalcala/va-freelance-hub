---
import {
  DIRECTORY_CATEGORY_INFO,
  DIRECTORY_NICHES,
  type DirectoryCategory,
} from '@/lib/directory-categories';

type Props = {
  selectedCategory: DirectoryCategory | null;
};

const { selectedCategory } = Astro.props;

function categoryUrl(category: DirectoryCategory) {
  return `/directory?category=${encodeURIComponent(category)}`;
}
---

<section aria-labelledby="directory-index-title" class="mb-10">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="directory-index-title" class="text-xl font-extrabold tracking-tight text-ink">Find your lane</h2>
      <p class="mt-1 text-sm text-ink/50">Choose a category first so you are not scanning one giant company list.</p>
    </div>
    {selectedCategory && <a href="/directory" class="text-sm font-semibold text-accent hover:text-accent-hover">View all categories</a>}
  </div>

  <nav aria-label="Agency categories" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
    {DIRECTORY_NICHES.map((category) => {
      const info = DIRECTORY_CATEGORY_INFO[category];
      const isActive = selectedCategory === category;
      return (
        <a
          href={categoryUrl(category)}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'group flex items-start gap-3 rounded-xl border px-4 py-3 transition-colors',
            isActive
              ? 'border-accent/35 bg-accent-soft text-accent'
              : 'border-ink/[0.08] bg-surface hover:border-accent/25 hover:bg-accent-soft/40',
          ]}
        >
          <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${info.dot}`} aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block text-sm font-bold text-ink group-hover:text-accent">{info.shortTitle}</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-ink/45">{info.description}</span>
          </span>
        </a>
      );
    })}
  </nav>

  <div class="mt-3 flex flex-wrap items-center gap-2" aria-label="Focused directory views">
    <span class="mr-1 text-xs font-bold uppercase tracking-overline text-ink/40">Quick views</span>
    {(['dayshift', 'marketplaces'] as const).map((category) => {
      const info = DIRECTORY_CATEGORY_INFO[category];
      const isActive = selectedCategory === category;
      return (
        <a
          href={categoryUrl(category)}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors',
            isActive ? 'border-accent bg-accent text-white' : 'border-ink/10 bg-surface text-ink/60 hover:border-accent/30 hover:text-accent',
          ]}
        >
          <span class={`h-1.5 w-1.5 rounded-full ${info.dot}`} aria-hidden="true"></span>
          {info.shortTitle}
        </a>
      );
    })}
  </div>
</section>
