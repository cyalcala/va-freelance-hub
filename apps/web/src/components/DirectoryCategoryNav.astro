---
import {
  DIRECTORY_CATEGORY_INFO,
  DIRECTORY_NICHES,
  type DirectoryCategory,
} from '@/lib/directory-categories';

type Props = {
  selectedCategory: DirectoryCategory | null;
  query: string;
};

const { selectedCategory, query } = Astro.props;

function categoryUrl(category: DirectoryCategory | null) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  const qs = params.toString();
  return qs ? `/directory?${qs}` : '/directory';
}
---

<section aria-labelledby="directory-index-title" class="directory-categories">
  <h2 id="directory-index-title">Browse by category</h2>
  <nav aria-label="Agency categories" class="category-links">
    <a href={categoryUrl(null)} aria-current={!selectedCategory ? 'page' : undefined}>All categories</a>
    {DIRECTORY_NICHES.map((category) => {
      const info = DIRECTORY_CATEGORY_INFO[category];
      return (
        <a
          href={categoryUrl(category)}
          aria-current={selectedCategory === category ? 'page' : undefined}
          title={info.description}
        >
          {info.shortTitle}
        </a>
      );
    })}
  </nav>
  <nav aria-label="Focused directory views" class="category-links focused-views">
    <span class="text-muted">Focused views</span>
    {(['dayshift', 'marketplaces'] as const).map((category) => {
      const info = DIRECTORY_CATEGORY_INFO[category];
      return (
        <a
          href={categoryUrl(category)}
          aria-current={selectedCategory === category ? 'page' : undefined}
          title={info.description}
        >
          {info.shortTitle}
        </a>
      );
    })}
  </nav>
</section>

<style>
  .directory-categories { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--divider); }
  h2 { margin-bottom: 8px; font-size: 15px; font-weight: 600; }
  .category-links { display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .category-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 12px; border-radius: 6px; color: var(--muted); font-size: 14px; font-weight: 500; line-height: 1.5; transition: color 160ms, background-color 160ms; }
  .category-links a:hover { color: var(--ink); background: var(--recessed); }
  .category-links a[aria-current="page"] { color: var(--accent-hover); background: var(--accent-soft); font-weight: 600; }
  .focused-views { margin-top: 8px; }
  .focused-views > span { display: inline-flex; align-items: center; min-height: 44px; padding-right: 4px; font-size: 13px; }
  @media (width < 768px) {
    .category-links { gap: 4px; }
    .category-links a { padding-inline: 10px; }
  }
</style>
