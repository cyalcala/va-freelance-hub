---
import '../styles/globals.css';
import { Footer } from '@/components/footer';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isActive = (base: string) =>
  base === '/' ? path === '/' : path.startsWith(base);
const jobsActive = isActive('/opportunities') || isActive('/categories') || isActive('/jobs');
const boardStatus = Astro.response.headers.get('X-Public-Snapshot');
const boardTime = Astro.response.headers.get('X-Public-Snapshot-Generated-At');
const savedBoard = boardStatus === 'stale' || boardStatus === 'lkg_fallback';
const savedBoardDate = boardTime && Number.isFinite(Date.parse(boardTime))
  ? new Intl.DateTimeFormat('en-PH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Manila' }).format(new Date(boardTime))
  : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF9F6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://remotejobs-ph.pages.dev/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://remotejobs-ph.pages.dev/og-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..700&display=swap" rel="stylesheet">
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-parchment text-ink antialiased selection:bg-accent/20 selection:text-ink flex flex-col">

    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="site-container site-header-inner">
        <a href="/" class="site-brand" aria-label="VA & Freelance Hub home">
          <span class="site-brand-mark" aria-hidden="true">VA</span>
          <span>
            VA <span class="text-accent">&amp;</span> Freelance Hub
          </span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
          <a href="/opportunities" aria-current={jobsActive ? 'page' : undefined}>Jobs</a>
          <a href="/directory" aria-current={isActive('/directory') ? 'page' : undefined}>Companies</a>
        </nav>
      </div>
    </header>

    <div class="site-container flex-1">
      <main id="main-content" class="site-main" tabindex="-1">
        {savedBoard && <p class="saved-board-notice">
          <strong>Showing saved listings</strong>{savedBoardDate && <> last refreshed <time datetime={boardTime!}>{savedBoardDate} Philippine time</time></>}.
          {' '}Confirm availability with the employer. If Apply is temporarily unavailable, please retry shortly.
        </p>}
        <slot />
      </main>
    </div>

    <div class="site-footer-wrap">
      <div class="site-container">
        <Footer />
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Primary mobile">
        <a href="/" aria-current={isActive('/') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
          <span>Home</span>
        </a>
        <a href="/opportunities" aria-current={jobsActive ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          <span>Jobs</span>
        </a>
        <a href="/directory" aria-current={isActive('/directory') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>
          <span>Companies</span>
        </a>
    </nav>
  </body>
</html>
