# Dependencies
node_modules/
.pnp
.pnp.js

# Isolated agent workspaces
.worktrees/

# Environment and local Cloudflare secrets. Keep examples tracked.
.env*
!.env.example
!.env.*.example
.dev.vars*
!.dev.vars.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Build outputs
.next/
out/
dist/
build/

# Astro content artifacts are generated by astro sync and must not become
# accidental source files when dependency upgrades regenerate them.
apps/web/.astro/content-assets.mjs
apps/web/.astro/content-modules.mjs
apps/web/.astro/content.d.ts

# Cloudflare local runtime state
.wrangler/

# Bun
bun.lockb
*.bun

# Turso local
.turso/
*.db
*.db-shm
*.db-wal

# Zig build artifacts
packages/zig-parser/zig-cache/
packages/zig-parser/zig-out/
packages/zig-parser/src/*.o

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Vercel
.vercel/

# Trigger.dev
.trigger/
