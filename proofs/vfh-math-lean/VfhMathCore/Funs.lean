def processing_mode.check_version_mismatch
  (stored : types.VersionDeps) (current : types.VersionDeps)
  (out : Array types.Dependency 8#usize) (has_unknown : Bool) :
  Result (Std.Usize × (Array types.Dependency 8#usize) × Bool)
