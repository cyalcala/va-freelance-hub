  Result (processing_mode.ProcessingMode × Str × (Array types.Dependency
    8#usize) × Std.Usize)
  := do
  let empty := Array.repeat 8#usize types.Dependency.Geo
  if input.opt_out
  then
    let (empty1, n) ←
      processing_mode.push_dep empty 0#usize types.Dependency.SourceAuthority
    let (empty2, n1) ←
      processing_mode.push_dep empty1 n types.Dependency.Policy
    ok (processing_mode.ProcessingMode.BoundedReplay, toStr
      "Source opted out - withdrawal propagation required", empty2, n1)
  else
    match input.policy_expiry_ms with
    | none =>
      match input.lease_expiry_ms with
      | none =>
        let (n, empty1, has_unknown) ←
          processing_mode.check_version_mismatch input.version_deps current
            empty false
        if n > 0#usize
        then
          if has_unknown
          then
            ok (processing_mode.ProcessingMode.Full, toStr
              "Unknown version dependency - conservative FULL required",
              empty1, n)
          else
            if n = 1#usize
            then
              let d ← Array.index_usize empty1 0#usize
              let b ← processing_mode.is_targeted d
              if b
              then
                ok (processing_mode.ProcessingMode.BoundedReplay, toStr
                  "Targeted dependency version change", empty1, n)
              else
                ok (processing_mode.ProcessingMode.Reindex, toStr
                  "Version mismatch", empty1, n)
            else
              ok (processing_mode.ProcessingMode.Reindex, toStr
                "Version mismatch", empty1, n)
        else
          let b ← processing_mode.sufficient_evidence input
          if b
          then
            ok (processing_mode.ProcessingMode.Reuse, toStr
              "Sufficient compatible evidence exists; no dependency changes",
              empty, 0#usize)
          else
            ok (processing_mode.ProcessingMode.Full, toStr
              "Insufficient prior evidence or first evaluation", empty,
              0#usize)
      | some exp =>
        if exp < now_ms
        then
          let (empty1, n) ←
            processing_mode.push_dep empty 0#usize
              types.Dependency.SourceAuthority
          ok (processing_mode.ProcessingMode.BoundedReplay, toStr
            "Evidence lease expired - fresh evidence required", empty1, n)
        else
          let (n, empty1, has_unknown) ←
            processing_mode.check_version_mismatch input.version_deps current
              empty false
          if n > 0#usize
          then
            if has_unknown
            then
              ok (processing_mode.ProcessingMode.Full, toStr
                "Unknown version dependency - conservative FULL required",
                empty1, n)
            else
              if n = 1#usize
              then
                let d ← Array.index_usize empty1 0#usize
                let b ← processing_mode.is_targeted d
                if b
                then
                  ok (processing_mode.ProcessingMode.BoundedReplay, toStr
                    "Targeted dependency version change", empty1, n)
                else
                  ok (processing_mode.ProcessingMode.Reindex, toStr
                    "Version mismatch", empty1, n)
              else
                ok (processing_mode.ProcessingMode.Reindex, toStr
                  "Version mismatch", empty1, n)
          else
            let b ← processing_mode.sufficient_evidence input
            if b
            then
              ok (processing_mode.ProcessingMode.Reuse, toStr
                "Sufficient compatible evidence exists; no dependency changes",
                empty, 0#usize)
            else
              ok (processing_mode.ProcessingMode.Full, toStr
                "Insufficient prior evidence or first evaluation", empty,
                0#usize)
    | some exp =>
      if exp < now_ms
      then
        let (empty1, n) ←
          processing_mode.push_dep empty 0#usize types.Dependency.Policy
        let (empty2, n1) ←
          processing_mode.push_dep empty1 n types.Dependency.SourceAuthority
        ok (processing_mode.ProcessingMode.BoundedReplay, toStr
          "Policy lease expired - re-evaluation required", empty2, n1)
      else
        match input.lease_expiry_ms with
        | none =>
          let (n, empty1, has_unknown) ←
            processing_mode.check_version_mismatch input.version_deps current
              empty false
          if n > 0#usize
          then
            if has_unknown
            then
              ok (processing_mode.ProcessingMode.Full, toStr
                "Unknown version dependency - conservative FULL required",
                empty1, n)
            else
              if n = 1#usize
              then
                let d ← Array.index_usize empty1 0#usize
                let b ← processing_mode.is_targeted d
                if b
                then
                  ok (processing_mode.ProcessingMode.BoundedReplay, toStr
                    "Targeted dependency version change", empty1, n)
                else
                  ok (processing_mode.ProcessingMode.Reindex, toStr
                    "Version mismatch", empty1, n)
              else
                ok (processing_mode.ProcessingMode.Reindex, toStr
                  "Version mismatch", empty1, n)
          else
            let b ← processing_mode.sufficient_evidence input
            if b
            then
              ok (processing_mode.ProcessingMode.Reuse, toStr
                "Sufficient compatible evidence exists; no dependency changes",
                empty, 0#usize)
            else
              ok (processing_mode.ProcessingMode.Full, toStr
                "Insufficient prior evidence or first evaluation", empty,
                0#usize)
        | some exp1 =>
          if exp1 < now_ms
          then
            let (empty1, n) ←
              processing_mode.push_dep empty 0#usize
                types.Dependency.SourceAuthority
            ok (processing_mode.ProcessingMode.BoundedReplay, toStr
              "Evidence lease expired - fresh evidence required", empty1, n)
          else
            let (n, empty1, has_unknown) ←
              processing_mode.check_version_mismatch input.version_deps current
                empty false
            if n > 0#usize
            then
              if has_unknown
              then
                ok (processing_mode.ProcessingMode.Full, toStr
                  "Unknown version dependency - conservative FULL required",
                  empty1, n)
              else
                if n = 1#usize
                then
                  let d ← Array.index_usize empty1 0#usize
                  let b ← processing_mode.is_targeted d
                  if b
                  then
                    ok (processing_mode.ProcessingMode.BoundedReplay, toStr
                      "Targeted dependency version change", empty1, n)
                  else
                    ok (processing_mode.ProcessingMode.Reindex, toStr
                      "Version mismatch", empty1, n)
                else
                  ok (processing_mode.ProcessingMode.Reindex, toStr
                    "Version mismatch", empty1, n)
            else
              let b ← processing_mode.sufficient_evidence input
              if b
              then
                ok (processing_mode.ProcessingMode.Reuse, toStr
                  "Sufficient compatible evidence exists; no dependency changes",
                  empty, 0#usize)
              else
                ok (processing_mode.ProcessingMode.Full, toStr
                  "Insufficient prior evidence or first evaluation", empty,
                  0#usize)

