  let b ←
    core.cmp.impls.PartialEqShared.ne Str.Insts.CoreCmpPartialEqStr
      current.fingerprint_hash cached.fingerprint_hash
  if b
  then ok true
  else
    let b1 ←
      core.cmp.impls.PartialEqShared.ne Str.Insts.CoreCmpPartialEqStr
        current.content_hash cached.content_hash
    if b1
    then ok true
    else
      let b2 ←
        core.cmp.impls.PartialEqShared.ne Str.Insts.CoreCmpPartialEqStr
          current.policy_hash cached.policy_hash
      if b2
      then ok true
      else
        match current.description_hash with
        | none => ok false
        | some a =>
          match cached.description_hash with
          | none => ok false
          | some b3 =>
            core.cmp.impls.PartialEqShared.ne Str.Insts.CoreCmpPartialEqStr a
              b3

