def processing_mode.select_processing_mode
  (input : processing_mode.ModeInput) (current : types.VersionDeps)
  (now_ms : Std.U64) (cached_digests : Option types.MaterialDigests) :
  Result processing_mode.ModeDecision
  := do
  let (mode, reason, _, n) ←
    processing_mode.decide_legacy input current now_ms
  let b ←
    processing_mode.ProcessingMode.Insts.CoreCmpPartialEqProcessingMode.eq mode
      processing_mode.ProcessingMode.Reuse
  if b
  then
    match cached_digests with
    | none => ok { mode, reason, dependency_count := n }
    | some md =>
      let b1 ←
        processing_mode.material_digests_changed input.material_digests md
      if b1
      then
        ok
          {
            mode := processing_mode.ProcessingMode.BoundedReplay,
            reason :=
              (toStr
                "Material digest changed - cached mode is not content-valid"),
            dependency_count := 1#usize
          }
      else ok { mode, reason, dependency_count := n }
  else ok { mode, reason, dependency_count := n }

