      types.Dependency.Geo out2 n1 has_unknown2
  let (out4, n3, has_unknown4) ←
    processing_mode.check_one stored.triage_version current.triage_version
      types.Dependency.Taxonomy out3 n2 has_unknown3
  let (out5, n4, has_unknown5) ←
    processing_mode.check_one stored.jev_version current.jev_version
      types.Dependency.Model out4 n3 has_unknown4
  let (out6, n5, has_unknown6) ←
    processing_mode.check_one stored.fingerprint_version
      current.fingerprint_version types.Dependency.Identity out5 n4
      has_unknown5
  let (out7, n6, has_unknown7) ←
