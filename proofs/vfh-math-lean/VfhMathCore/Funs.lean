def processing_mode.is_targeted (dep : types.Dependency) : Result Bool := do
  match dep with
  | types.Dependency.Geo => ok true
  | types.Dependency.Remote => ok false
  | types.Dependency.Identity => ok true
  | types.Dependency.Url => ok false
  | types.Dependency.SourceAuthority => ok false
  | types.Dependency.Policy => ok true
  | types.Dependency.Parser => ok false
  | types.Dependency.Schema => ok false
  | types.Dependency.Model => ok false
  | types.Dependency.Taxonomy => ok true

