    content_hash.write_u32be value out ⦃ out' =>
      out'.length = out.length ∧
      (out'.val[0]?.map (·.val) = some ((value.val / 16777216) % 256)) ∧
      (out'.val[1]?.map (·.val) = some ((value.val / 65536) % 256)) ∧
      (out'.val[2]?.map (·.val) = some ((value.val / 256) % 256)) ∧
      (out'.val[3]?.map (·.val) = some (value.val % 256)) ⦄ := by
  unfold content_hash.write_u32be
  step as ⟨i, hi⟩
  step as ⟨i1, hi1⟩
  step as ⟨out1, hout1⟩
  step as ⟨i2, hi2⟩
  step as ⟨i3, hi3⟩
  step as ⟨out2, hout2⟩
  step as ⟨i4, hi4⟩
  step as ⟨i5, hi5⟩
  step as ⟨out3, hout3⟩
  step as ⟨i6, hi6⟩
  step as ⟨out4, hout4⟩
  · simp_all [Slice.length]; omega
  · have hlen' : 4 ≤ out.val.length := hlen
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simp_all [Slice.length]
    · simp only [hout4, hout3, hout2, hout1, slice_set_val, UScalar.ofNatCore_val_eq]
      simp only [List.getElem?_set_ne (by omega : 3 ≠ 0),
        List.getElem?_set_ne (by omega : 2 ≠ 0),
        List.getElem?_set_ne (by omega : 1 ≠ 0),
        List.getElem?_set_self (by omega : 0 < out.val.length),
        Option.map_some, hi1, u32_cast_u8_val, hi, Nat.shiftRight_eq_div_pow]
    · simp only [hout4, hout3, hout2, hout1, slice_set_val, UScalar.ofNatCore_val_eq]
      simp only [List.getElem?_set_ne (by omega : 3 ≠ 1),
        List.getElem?_set_ne (by omega : 2 ≠ 1),
        List.getElem?_set_self (by simp; omega : 1 < (out.val.set 0 i1).length),
        Option.map_some, hi3, u32_cast_u8_val, hi2, Nat.shiftRight_eq_div_pow]
    · simp only [hout4, hout3, hout2, hout1, slice_set_val, UScalar.ofNatCore_val_eq]
      simp only [List.getElem?_set_ne (by omega : 3 ≠ 2),
        List.getElem?_set_self (by simp; omega : 2 < ((out.val.set 0 i1).set 1 i3).length),
        Option.map_some, hi5, u32_cast_u8_val, hi4, Nat.shiftRight_eq_div_pow]
    · simp only [hout4, hout3, hout2, hout1, slice_set_val, UScalar.ofNatCore_val_eq]
      simp only [
        List.getElem?_set_self (by simp; omega : 3 < (((out.val.set 0 i1).set 1 i3).set 2 i5).length),
        Option.map_some, hi6, u32_cast_u8_val]

/-- Specification of `content_hash.encode_v2_bytes_loop0`: copies `title` into `out`
    starting at offset `base = i - j`, preserving bytes strictly before `base`. -/
@[step]
theorem encode_v2_bytes_loop0_spec
    (title out : Slice Std.U8) (i j : Std.Usize) (base : Nat)
    (hj : j.val ≤ title.length)
    (hi : i.val = base + j.val)
    (ho : base + title.length ≤ out.length)
    (hpre : ∀ k < j.val, out.val[base + k]? = title.val[k]?) :
    content_hash.encode_v2_bytes_loop0 title out i j ⦃ (out', i') =>
      out'.length = out.length ∧
      i'.val = base + title.length ∧
      (∀ k < base, out'.val[k]? = out.val[k]?) ∧
      (∀ k < title.length, out'.val[base + k]? = title.val[k]?) ⦄ := by
  unfold content_hash.encode_v2_bytes_loop0
  apply loop.spec_decr_nat
    (measure := fun (_, _, j1) => title.length - j1.val)
    (inv := fun (out1, i1, j1) =>
      j1.val ≤ title.length ∧
      i1.val = base + j1.val ∧
      out1.length = out.length ∧
      (∀ k < base, out1.val[k]? = out.val[k]?) ∧
      (∀ k < j1.val, out1.val[base + k]? = title.val[k]?))
  · rintro ⟨out1, i1, j1⟩ ⟨hj1, hi1, hlen1, hkeep1, hcopy1⟩
    unfold content_hash.encode_v2_bytes_loop0.body
    by_cases hlt : j1 < Slice.len title
    · simp only [hlt, ↓reduceIte]
      have hj1_lt : j1.val < title.length := by
        simpa [Slice.len, Slice.length, UScalar.lt_equiv] using hlt
      have hi1_lt : i1.val < out1.length := by omega
      step as ⟨b, hb⟩
      step as ⟨s, hs⟩
      step as ⟨i3, hi3⟩
      step as ⟨j2, hj2⟩
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · omega
      · omega
      · rw [hs, Slice.length, slice_set_val, List.length_set]; exact hlen1
      · intro k hk
        rw [hs, slice_set_val, List.getElem?_set_ne (by omega)]
        exact hkeep1 k hk
      · intro k hk
        rw [hs, slice_set_val]
        by_cases hkj : k = j1.val
        · subst hkj
          have hi1_lt' : i1.val < out1.val.length := hi1_lt
          have hj1_lt' : j1.val < title.val.length := hj1_lt
          rw [show base + j1.val = i1.val by omega, List.getElem?_set_self hi1_lt']
          simp [hb, List.getElem?_eq_getElem hj1_lt']
        · rw [List.getElem?_set_ne (by omega)]
          exact hcopy1 k (by omega)
      · omega
    · simp only [hlt, ↓reduceIte, WP.spec_ok]
      have hj1_eq : j1.val = title.length := by
        have : ¬ (j1.val < title.length) := by
          simpa [Slice.len, Slice.length, UScalar.lt_equiv] using hlt
        omega
      refine ⟨hlen1, by omega, hkeep1, ?_⟩
      intro k hk
      exact hcopy1 k (by omega)
  · refine ⟨hj, hi, rfl, fun _ _ => rfl, hpre⟩

