/-- The v2 digest prefix is exactly the three ASCII bytes `v`, `2`, `:`.
    This is the row-shape guard that keeps `contentHash@v2` from colliding
    with stored 16-hex `contentHash@v1` D1 values. -/
theorem v2_prefix_bytes :
    content_hash.V2_PREFIX = toStr "v2:" := by
  simp [content_hash.V2_PREFIX]

/-- MATH-00 / MATH-09: `ContentHashVersion::tag` returns the live v1 scheme tag. -/
theorem content_hash_version_tag_v1 :
    types.ContentHashVersion.tag types.ContentHashVersion.V1
      = ok types.CONTENT_HASH_VERSION_V1 := by
  simp [types.ContentHashVersion.tag]

/-- MATH-00 / MATH-09: `ContentHashVersion::tag` returns the v2 scheme tag. -/
