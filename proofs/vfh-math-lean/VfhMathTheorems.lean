/-- Full functional specification of `content_hash.encode_v2_bytes` when lengths fit in
    `u32` and the output buffer has at least `8 + title.length + url.length` bytes. -/
theorem encode_v2_bytes_spec
    (title url out : Slice Std.U8)
    (ht : title.length ≤ Std.U32.max)
    (hu : url.length ≤ Std.U32.max)
    (ho : 8 + title.length + url.length ≤ out.length) :
    content_hash.encode_v2_bytes title url out ⦃ (opt, res) =>
      ∃ n : Std.Usize,
        opt = some n ∧
        n.val = 8 + title.length + url.length ∧
        res.length = out.length ∧
        (res.val[0]?.map (·.val) = some ((title.length / 16777216) % 256)) ∧
        (res.val[1]?.map (·.val) = some ((title.length / 65536) % 256)) ∧
        (res.val[2]?.map (·.val) = some ((title.length / 256) % 256)) ∧
        (res.val[3]?.map (·.val) = some (title.length % 256)) ∧
        (∀ k < title.length, res.val[4 + k]? = title.val[k]?) ∧
        (∀ k < url.length, res.val[8 + title.length + k]? = url.val[k]?) ⦄ := by
  unfold content_hash.encode_v2_bytes
  have h1_not : ¬ (Slice.len title > UScalar.cast .Usize core.num.U32.MAX) := by
    change ¬ (UScalar.cast .Usize core.num.U32.MAX < Slice.len title)
    simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
  have h2_not : ¬ (Slice.len url > UScalar.cast .Usize core.num.U32.MAX) := by
    change ¬ (UScalar.cast .Usize core.num.U32.MAX < Slice.len url)
    simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
  step as ⟨i1, hi1⟩
  simp only [hi1, h1_not, ↓reduceIte]
  step as ⟨i3, hi3⟩
  simp only [hi3, h2_not, ↓reduceIte]
  step as ⟨i5, hi5⟩
  step as ⟨need, hneed⟩
  have hneed_val : need.val = 8 + title.length + url.length := by
    simp only [Slice.len_val] at hi5 hneed; omega
  have hneed_not : ¬ (Slice.len out < need) := by
    simp only [UScalar.lt_equiv, Slice.len_val]; omega
  simp only [hneed_not, ↓reduceIte]
  step as ⟨i9, hi9⟩
  have hi9_val : i9.val = title.length := by
    rw [hi9, usize_cast_u32_val (Slice.len title) (by simpa [Slice.len_val] using ht), Slice.len_val]
  step as ⟨s, index_mut_back, hs_val, hs_len, hback⟩
  step as ⟨s1, hs1_len, hs1_0, hs1_1, hs1_2, hs1_3⟩
  have hout1_eq : index_mut_back s1 = out.setSlice! 0 s1 := by
    simpa [UScalar.ofNatCore_val_eq] using hback s1
  have hout1_len : (index_mut_back s1).length = out.length := by
    rw [hout1_eq]; simp_lists [Slice.length]
  have hout1_prefix : ∀ k < 4, (index_mut_back s1).val[k]? = s1.val[k]? := by
    intro k hk
    rw [hout1_eq, Slice.setSlice!_val]
    have h4 : 4 ≤ out.val.length := by simp [Slice.length] at ho; omega
    have hs1l : s1.val.length = 4 := by simp [Slice.length] at hs1_len hs_len; omega
    simp_lists [List.setSlice!_getElem?_middle]
  have hloop0 := encode_v2_bytes_loop0_spec title (index_mut_back s1) 4#usize 0#usize 4
    (by simp [UScalar.ofNatCore_val_eq])
    (by simp [UScalar.ofNatCore_val_eq])
    (by omega)
    (by intro k hk; simp [UScalar.ofNatCore_val_eq] at hk)
  step with hloop0 as ⟨out2, i10, hout2_len, hi10_val, hout2_keep, hout2_copy⟩
  step as ⟨i12, hi12⟩
  step as ⟨i13, hi13⟩
  have hi13_val : i13.val = 8 + title.length := by omega
  step as ⟨s2, index_mut_back1, hs2_val, hs2_len, hback1⟩
  step as ⟨s3, hs3_len, _, _, _, _⟩
  have hout3_eq : index_mut_back1 s3 = out2.setSlice! i10.val s3 := hback1 s3
  have hout3_len : (index_mut_back1 s3).length = out.length := by
    rw [hout3_eq]; simp_lists [Slice.length, hout2_len, hout1_len]
  have hout3_keep : ∀ k < 4 + title.length, (index_mut_back1 s3).val[k]? = out2.val[k]? := by
    intro k hk
    rw [hout3_eq, Slice.setSlice!_val]
    have hlt : k < i10.val := by omega
    simp_lists [List.setSlice!_getElem?_prefix]
  have hloop1 := encode_v2_bytes_loop1_spec url (index_mut_back1 s3) i13 0#usize (8 + title.length)
    (by simp [UScalar.ofNatCore_val_eq])
    (by simp [UScalar.ofNatCore_val_eq]; omega)
    (by omega)
    (by intro k hk; simp [UScalar.ofNatCore_val_eq] at hk)
  step with hloop1 as ⟨out4, i14, hout4_len, hi14_val, hout4_keep, hout4_copy⟩
  refine ⟨i14, rfl, by omega, by omega, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hout4_keep 0 (by omega), hout3_keep 0 (by omega), hout2_keep 0 (by omega),
      hout1_prefix 0 (by omega), hs1_0, hi9_val]
  · rw [hout4_keep 1 (by omega), hout3_keep 1 (by omega), hout2_keep 1 (by omega),
      hout1_prefix 1 (by omega), hs1_1, hi9_val]
  · rw [hout4_keep 2 (by omega), hout3_keep 2 (by omega), hout2_keep 2 (by omega),
      hout1_prefix 2 (by omega), hs1_2, hi9_val]
  · rw [hout4_keep 3 (by omega), hout3_keep 3 (by omega), hout2_keep 3 (by omega),
      hout1_prefix 3 (by omega), hs1_3, hi9_val]
  · intro k hk
    rw [hout4_keep (4 + k) (by omega), hout3_keep (4 + k) (by omega), hout2_copy k hk]
  · intro k hk
    exact hout4_copy k hk

/-- Whenever `encode_v2_bytes title url out` succeeds with `ok (some n, res)`,
    all length bounds hold and `res` matches the exact v2 length-prefixed layout. -/
theorem encode_v2_bytes_ok_some
    (title url out : Slice Std.U8) (n : Std.Usize) (res : Slice Std.U8)
    (h : content_hash.encode_v2_bytes title url out = ok (some n, res)) :
    title.length ≤ Std.U32.max ∧
    url.length ≤ Std.U32.max ∧
    n.val = 8 + title.length + url.length ∧
    res.length = out.length ∧
    n.val ≤ res.length ∧
    (res.val[0]?.map (·.val) = some ((title.length / 16777216) % 256)) ∧
    (res.val[1]?.map (·.val) = some ((title.length / 65536) % 256)) ∧
    (res.val[2]?.map (·.val) = some ((title.length / 256) % 256)) ∧
    (res.val[3]?.map (·.val) = some (title.length % 256)) ∧
    (∀ k < title.length, res.val[4 + k]? = title.val[k]?) ∧
    (∀ k < url.length, res.val[8 + title.length + k]? = url.val[k]?) := by
  have ht : title.length ≤ Std.U32.max := by
    by_contra hgt
    have hcond : Slice.len title > UScalar.cast .Usize core.num.U32.MAX := by
      change UScalar.cast .Usize core.num.U32.MAX < Slice.len title
      simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
    have hnone : content_hash.encode_v2_bytes title url out ⦃ fun r => r.1 = none ⦄ := by
      unfold content_hash.encode_v2_bytes
      step as ⟨i1, hi1⟩
      simp only [hi1, hcond, ↓reduceIte, WP.spec_ok]
    rw [h, WP.spec_ok] at hnone
    cases hnone
  have hu : url.length ≤ Std.U32.max := by
    by_contra hgt
    have h1 : ¬ (Slice.len title > UScalar.cast .Usize core.num.U32.MAX) := by
      change ¬ (UScalar.cast .Usize core.num.U32.MAX < Slice.len title)
      simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
    have h2 : Slice.len url > UScalar.cast .Usize core.num.U32.MAX := by
      change UScalar.cast .Usize core.num.U32.MAX < Slice.len url
      simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
    have hnone : content_hash.encode_v2_bytes title url out ⦃ fun r => r.1 = none ⦄ := by
      unfold content_hash.encode_v2_bytes
      step as ⟨i1, hi1⟩
      simp only [hi1, h1, ↓reduceIte]
      step as ⟨i3, hi3⟩
      simp only [hi3, h2, ↓reduceIte, WP.spec_ok]
    rw [h, WP.spec_ok] at hnone
    cases hnone
  have ho : 8 + title.length + url.length ≤ out.length := by
    by_contra hlt
    have h1 : ¬ (Slice.len title > UScalar.cast .Usize core.num.U32.MAX) := by
      change ¬ (UScalar.cast .Usize core.num.U32.MAX < Slice.len title)
      simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
    have h2 : ¬ (Slice.len url > UScalar.cast .Usize core.num.U32.MAX) := by
      change ¬ (UScalar.cast .Usize core.num.U32.MAX < Slice.len url)
      simp only [UScalar.lt_equiv, Slice.len_val, u32_max_cast_usize_val]; omega
    by_cases hov1 : 8 + title.length ≤ Std.Usize.max
    · by_cases hov2 : 8 + title.length + url.length ≤ Std.Usize.max
      · have hnone : content_hash.encode_v2_bytes title url out ⦃ fun r => r.1 = none ⦄ := by
          unfold content_hash.encode_v2_bytes
          step as ⟨i1, hi1⟩
          simp only [hi1, h1, ↓reduceIte]
          step as ⟨i3, hi3⟩
          simp only [hi3, h2, ↓reduceIte]
          step as ⟨i5, hi5⟩
          step as ⟨need, hneed⟩
          have hneed_val : need.val = 8 + title.length + url.length := by
            simp only [Slice.len_val] at hi5 hneed; omega
          have hcmp : Slice.len out < need := by
            simp only [UScalar.lt_equiv, Slice.len_val]; omega
          simp only [hcmp, ↓reduceIte, WP.spec_ok]
        rw [h, WP.spec_ok] at hnone
        cases hnone
      · obtain ⟨i5, hi5_eq, hi5_val⟩ := usize_add_ok 8#usize (Slice.len title)
          (by simp only [Slice.len_val, UScalar.ofNatCore_val_eq]; exact hov1)
        have hfail2 : i5 + Slice.len url = fail .integerOverflow :=
          usize_add_overflow i5 (Slice.len url) (by simp only [Slice.len_val, UScalar.ofNatCore_val_eq] at *; omega)
        have htrue : content_hash.encode_v2_bytes title url out ⦃ fun _ => True ⦄ := by
          rw [h, WP.spec_ok]; trivial
        unfold content_hash.encode_v2_bytes at htrue
        simp at h1 h2
        simp [lift, hi5_eq, hfail2, Nat.not_lt.mpr h1, Nat.not_lt.mpr h2, WP.spec_fail] at htrue
    · have hfail1 : 8#usize + Slice.len title = fail .integerOverflow :=
        usize_add_overflow 8#usize (Slice.len title) (by simp only [Slice.len_val, UScalar.ofNatCore_val_eq]; omega)
      have htrue : content_hash.encode_v2_bytes title url out ⦃ fun _ => True ⦄ := by
        rw [h, WP.spec_ok]; trivial
      unfold content_hash.encode_v2_bytes at htrue
      simp at h1 h2
      simp [lift, hfail1, Nat.not_lt.mpr h1, Nat.not_lt.mpr h2, WP.spec_fail] at htrue
  have hspec := encode_v2_bytes_spec title url out ht hu ho
  rw [h, WP.spec_ok] at hspec
  rcases hspec with ⟨n', hn', hn_val, hlen, hb0, hb1, hb2, hb3, htitle, hurl⟩
  cases hn'
  exact ⟨ht, hu, hn_val, hlen, by omega, hb0, hb1, hb2, hb3, htitle, hurl⟩

/-- MATH-09 (`F-W2-2`): Formal injectivity of `content_hash.encode_v2_bytes`.
    If two `(title, url)` byte-slice pairs encode to the same written prefix
    `res₁.val.take n₁.val = res₂.val.take n₂.val` (even into different output buffers),
    then `title₁ = title₂` and `url₁ = url₂`. -/
theorem encode_v2_bytes_injective
    (title₁ url₁ out₁ title₂ url₂ out₂ : Slice Std.U8)
    (n₁ n₂ : Std.Usize) (res₁ res₂ : Slice Std.U8)
    (h₁ : content_hash.encode_v2_bytes title₁ url₁ out₁ = ok (some n₁, res₁))
    (h₂ : content_hash.encode_v2_bytes title₂ url₂ out₂ = ok (some n₂, res₂))
    (heq : res₁.val.take n₁.val = res₂.val.take n₂.val) :
    title₁ = title₂ ∧ url₁ = url₂ := by
  obtain ⟨ht₁, _, hn₁, _, hle₁, hb10, hb11, hb12, hb13, htitle₁, hurl₁⟩ :=
    encode_v2_bytes_ok_some title₁ url₁ out₁ n₁ res₁ h₁
  obtain ⟨ht₂, _, hn₂, _, hle₂, hb20, hb21, hb22, hb23, htitle₂, hurl₂⟩ :=
    encode_v2_bytes_ok_some title₂ url₂ out₂ n₂ res₂ h₂
  have htake_len : n₁.val = n₂.val := by
    have := congrArg List.length heq
    simp only [List.length_take] at this
    have h1 : res₁.val.length = res₁.length := rfl
    have h2 : res₂.val.length = res₂.length := rfl
    omega
  have hget : ∀ k < n₁.val, res₁.val[k]? = res₂.val[k]? := by
    intro k hk
    have hk2 : k < n₂.val := by omega
    have h := congrArg (fun l => l[k]?) heq
    simpa [List.getElem?_take_of_lt hk, List.getElem?_take_of_lt hk2] using h
  have htlen : title₁.length = title₂.length := by
    apply u32be_bytes_inj ht₁ ht₂
    · have := congrArg (Option.map (·.val)) (hget 0 (by omega))
      rw [hb10, hb20] at this; exact Option.some.inj this
    · have := congrArg (Option.map (·.val)) (hget 1 (by omega))
      rw [hb11, hb21] at this; exact Option.some.inj this
    · have := congrArg (Option.map (·.val)) (hget 2 (by omega))
      rw [hb12, hb22] at this; exact Option.some.inj this
    · have := congrArg (Option.map (·.val)) (hget 3 (by omega))
      rw [hb13, hb23] at this; exact Option.some.inj this
  have hulen : url₁.length = url₂.length := by omega
  constructor
  · rw [Slice.eq_iff]
    apply List.ext_getElem?
    intro k
    by_cases hk : k < title₁.length
    · rw [← htitle₁ k hk, hget (4 + k) (by omega), htitle₂ k (by omega)]
    · have hk1 : title₁.val.length ≤ k := by simpa [Slice.length] using hk
      have hk2 : title₂.val.length ≤ k := by simp [Slice.length] at htlen; omega
      rw [List.getElem?_eq_none hk1, List.getElem?_eq_none hk2]
  · rw [Slice.eq_iff]
    apply List.ext_getElem?
    intro k
    by_cases hk : k < url₁.length
    · have h := hget (8 + title₁.length + k) (by omega)
      rw [hurl₁ k hk, htlen, hurl₂ k (by omega)] at h
      exact h
    · have hk1 : url₁.val.length ≤ k := by simpa [Slice.length] using hk
      have hk2 : url₂.val.length ≤ k := by simp [Slice.length] at hulen; omega
      rw [List.getElem?_eq_none hk1, List.getElem?_eq_none hk2]

/-- Convenience corollary of `encode_v2_bytes_injective` when both calls return the
    exact same `(some n, res)` pair. -/
theorem encode_v2_bytes_injective_eq
    (title₁ url₁ out₁ title₂ url₂ out₂ : Slice Std.U8)
    (n : Std.Usize) (res : Slice Std.U8)
    (h₁ : content_hash.encode_v2_bytes title₁ url₁ out₁ = ok (some n, res))
    (h₂ : content_hash.encode_v2_bytes title₂ url₂ out₂ = ok (some n, res)) :
    title₁ = title₂ ∧ url₁ = url₂ :=
  encode_v2_bytes_injective title₁ url₁ out₁ title₂ url₂ out₂ n n res res h₁ h₂ rfl
