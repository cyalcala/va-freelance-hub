  simp [types.ContentHashVersion.tag]

/-! ## MATH-09 (`F-W2-2`): Formal injectivity of `encode_v2_bytes` -/

private theorem u32be_bytes_inj {a b : Nat}
    (ha : a ≤ Std.U32.max) (hb : b ≤ Std.U32.max)
    (h0 : (a / 16777216) % 256 = (b / 16777216) % 256)
    (h1 : (a / 65536) % 256 = (b / 65536) % 256)
    (h2 : (a / 256) % 256 = (b / 256) % 256)
    (h3 : a % 256 = b % 256) :
    a = b := by
  have ha' : a < 4294967296 := by
    change a < 2 ^ 32
    have := Std.U32.max_eq
    omega
  have hb' : b < 4294967296 := by
    change b < 2 ^ 32
    have := Std.U32.max_eq
    omega
  omega

private theorem u32_cast_u8_val (x : Std.U32) :
    (UScalar.cast .U8 x).val = x.val % 256 := by
  simp only [UScalar.cast, UScalar.val, BitVec.toNat_setWidth]
  rfl

private theorem slice_set_val (s : Slice Std.U8) (idx : Std.Usize) (v : Std.U8) :
    (s.set idx v).val = s.val.set idx.val v := by
  simp [Slice.set, Slice.setAtNat]

private theorem u32_max_cast_usize_val :
    (UScalar.cast .Usize core.num.U32.MAX).val = Std.U32.max := by
  have hbound := Usize.cMax_bound_concrete
  have hmax : core.num.U32.MAX.bv.toNat = 4294967295 := by decide
  have hmax2 := Std.U32.max_eq
  have hlt : 4294967295 < 2 ^ UScalarTy.Usize.numBits := by
    change 4294967295 < 2 ^ System.Platform.numBits
    omega
  simp only [UScalar.cast, UScalar.val, BitVec.toNat_setWidth, hmax]
  rw [Nat.mod_eq_of_lt hlt, hmax2]

private theorem usize_cast_u32_val (x : Std.Usize) (hx : x.val ≤ Std.U32.max) :
    (UScalar.cast .U32 x).val = x.val := by
  simp only [UScalar.cast, UScalar.val, BitVec.toNat_setWidth]
  have hlt : x.val < 2 ^ 32 := by
    have := Std.U32.max_eq
    omega
  exact Nat.mod_eq_of_lt hlt

private theorem usize_add_overflow (x y : Std.Usize) (h : ¬ (x.val + y.val ≤ Std.Usize.max)) :
    x + y = fail .integerOverflow := by
  have hlt : ¬ (x.val + y.val < 2 ^ System.Platform.numBits) := by
    have := Usize.cMax_bound_concrete
    omega
  change UScalar.add x y = fail .integerOverflow
  simp [UScalar.add, UScalar.tryMk, UScalar.tryMkOpt, hlt]

private theorem usize_add_ok (x y : Std.Usize) (h : x.val + y.val ≤ Std.Usize.max) :
    ∃ z : Std.Usize, x + y = ok z ∧ z.val = x.val + y.val := by
  have hlt : x.val + y.val < 2 ^ System.Platform.numBits := by
    have := Usize.cMax_bound_concrete
    omega
  refine ⟨UScalar.ofNatCore (x.val + y.val) hlt, ?_, by simp [UScalar.ofNatCore_val_eq]⟩
  change UScalar.add x y = ok _
  simp [UScalar.add, UScalar.tryMk, UScalar.tryMkOpt, hlt]

/-- Specification of `content_hash.write_u32be`: writes the 4 big-endian bytes of
    `value` at indices `0..3` without changing slice length. -/
