# Local-only secrets for the active Cloudflare/Astro runtime.
# Copy this file to .dev.vars for Wrangler/Pages local development, or to .env
# for scripts that explicitly read environment variables. Never commit values.

# Required by authenticated ingestion and cron endpoints. Configure one or both
# in Cloudflare Pages production secrets and GitHub Actions secrets.
PROXY_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Optional: used only by the reviewed Gemini-assisted GHA Chef script.
GEMINI_API_KEY=replace-with-a-gemini-api-key
