generated_from_span":null}},"source_text":"fn decide_legacy(\n    input: &ModeInput<'_>,\n    current: VersionDeps<'_>,\n    now_ms: u64,\n) -> (ProcessingMode, &'static str, [Dependency; MAX_DEPS], usize) {\n    let empty = [Dependency::Geo; MAX_DEPS];\n    if input.opt_out {\n        let mut deps = empty;\n        let mut n = 0;\n        push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n        push_dep(&mut deps, &mut n, Dependency::Policy);\n        return (\n            ProcessingMode::BoundedReplay,\n            \"Source opted out - withdrawal propagation required\",\n            deps,\n            n,\n        );\n    }\n    if let Some(exp) = input.policy_expiry_ms {\n        if exp < now_ms {\n            let mut deps = empty;\n            let mut n = 0;\n            push_dep(&mut deps, &mut n, Dependency::Policy);\n            push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Policy lease expired - re-evaluation required\",\n                deps,\n                n,\n            );\n        }\n    }\n    if let Some(exp) = input.lease_expiry_ms {\n        if exp < now_ms {\n            let mut deps = empty;\n            let mut n = 0;\n            push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Evidence lease expired - fresh evidence required\",\n                deps,\n                n,\n            );\n        }\n    }\n\n    let mut mismatches = empty;\n    let mut has_unknown = false;\n    let n = check_version_mismatch(input.version_deps, current, &mut mismatches, &mut has_unknown);\n    if n > 0 {\n        if has_unknown {\n            return (\n                ProcessingMode::Full,\n                \"Unknown version dependency - conservative FULL required\",\n                mismatches,\n                n,\n            );\n        }\n        if n == 1 && is_targeted(mismatches[0]) {\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Targeted dependency version change\",\n                mismatches,\n                n,\n            );\n        }\n        return (\n            ProcessingMode::Reindex,\n            \"Version mismatch\",\n            mismatches,\n            n,\n        );\n    }\n\n    if sufficient_evidence(input) {\n        return (ProcessingMode::Reuse, \"Sufficient compatible evidence exists; no dependency changes\", empty, 0);\n    }\n    (\n        ProcessingMode::Full,\n        \"Insufficient prior evidence or first evaluation\",\n        empty,\n        0,\n    )\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false,"exported":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Var":{"Free":1}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":262},{"Value":[273,{"Adt":{"id":11,"generics":{"regions":[{"Var":{"Free":2}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Deduplicated":14}],"output":{"Value":[274,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":17},{"Deduplicated":18},{"Deduplicated":111},{"Deduplicated":0}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"src":"Normal","body":{"Structured":{"span":{"Value":[1161,{"data":{"file_id":13,"beg":{"line":137,"col":0},"end":{"line":220,"col":1}},"generated_fr