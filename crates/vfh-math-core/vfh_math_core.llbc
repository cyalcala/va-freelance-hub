{"charon_version":"0.1.329","translated":{"crate_name":"vfh_math_core","preset":"Aeneas","target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"arch":"X86_64","vendor":"unknown","os":"Linux","env":"Gnu","cfg_abi":"Unspecified","families":["unix"],"binary_format":"Elf","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"vfh_math_core","contents":"#![forbid(unsafe_code)]\n//! Pure VA Freelance Hub math core (Wave 1).\n//!\n//! - [`types`]: MATH-00 shared types and version tags\n//! - [`content_hash`]: MATH-09 content-hash input encodings (v1 legacy + v2 length-prefixed)\n//! - [`processing_mode`]: MATH-10 processing-mode selector, including the F-W2-1 digest fix\n//!\n//! This crate has zero I/O, zero `unsafe`, and no external dependencies so it can\n//! be translated by Charon → Aeneas → Lean 4. It does not write D1, touch Workers,\n//! or change stored `contentHash@v1` rows.\n\npub mod content_hash;\npub mod processing_mode;\npub mod types;\n\npub use content_hash::{\n    content_hash_v1, content_hash_v2, encode_v1_utf16, encode_v2_bytes, hash_utf16, hash_bytes,\n    ContentHash, CONTENT_HASH_SCHEME_V1, CONTENT_HASH_SCHEME_V2, V2_PREFIX,\n};\npub use processing_mode::{\n    material_digests_changed, select_processing_mode, select_processing_mode_legacy,\n    ModeDecision, ModeInput, ProcessingMode,\n};\npub use types::{\n    ContentHashVersion, Dependency, MaterialDigests, VersionDeps, CONTENT_HASH_VERSION_V1,\n    CONTENT_HASH_VERSION_V2, WAVE1_CONTRACT_VERSION,\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/hint.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"src/content_hash.rs"},"crate_name":"vfh_math_core","contents":"//! MATH-09 — content-hash input encodings.\n//!\n//! # F-W2-2 (recorded on `main`, still live in TypeScript)\n//! `toContentHash(t, u)` hashes the concatenation `t + \"::\" + u` with no length\n//! prefix. Therefore\n//! `toContentHash(\"A\", \"B::C\") == toContentHash(\"A::B\", \"C\")`.\n//!\n//! # Wave 1 fix (this crate only; D1 is not rewritten)\n//! - [`content_hash_v1`] reproduces the live TypeScript scheme byte-for-byte\n//!   (UTF-16 / `charCodeAt` + cyrb53, 16 lowercase hex chars) so we can keep\n//!   parity tests and so existing `contentHash@v1` rows stay meaningful.\n//! - [`content_hash_v2`] hashes a length-prefixed UTF-8 encoding and prefixes\n//!   the digest with [`V2_PREFIX`] (`\"v2:\"`). A v2 digest can never be confused\n//!   with a stored 16-hex v1 row, so D1 is not invalidated blindly.\n//!\n//! The length-prefixed encoding itself is injective on byte strings. The 64-bit\n//! fingerprint still has a birthday bound; F-W2-2 is an *encoding* collision,\n//! which v2 closes.\n\nuse crate::types::ContentHashVersion;\n\n/// ASCII prefix that marks a v2 digest. v1 digests are exactly 16 hex chars.\npub const V2_PREFIX: &str = \"v2:\";\npub const CONTENT_HASH_SCHEME_V1: &str = \"v1-utf16-colon-concat-cyrb53\";\npub const CONTENT_HASH_SCHEME_V2: &str = \"v2-utf8-u32be-length-prefixed-cyrb53\";\n\nconst HEX: &[u8; 16] = b\"0123456789abcdef\";\n\n/// A versioned content-hash digest. `hex` is the 16-char cyrb53 body, never\n/// including the `v2:` prefix (the prefix is applied by [`ContentHash::display`]).\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub struct ContentHash {\n    pub version: ContentHashVersion,\n    pub hex: [u8; 16],\n}\n\nimpl ContentHash {\n    /// v1: 16 hex chars. v2: `v2:` + 16 hex chars (19 bytes).\n    pub fn display(self, out: &mut [u8]) -> usize {\n        match self.version {\n            ContentHashVersion::V1 => {\n                out[..16].copy_from_slice(&self.hex);\n                16\n            }\n            ContentHashVersion::V2 => {\n                out[..3].copy_from_slice(b\"v2:\");\n                out[3..19].copy_from_slice(&self.hex);\n                19\n            }\n        }\n    }\n\n    pub fn is_v2_display(bytes: &[u8]) -> bool {\n        bytes.len() == 19 && bytes[0] == b'v' && bytes[1] == b'2' && bytes[2] == b':'\n    }\n}\n\n/// JS `Math.imul` — 32-bit wrapping signed multiply.\nfn imul(a: i32, b: i32) -> i32 {\n    a.wrapping_mul(b)\n}\n\n/// Unsigned JS `>>>` of an i32 value, returned as i32 with the same bit pattern.\nfn usr(x: i32, shift: u32) -> i32 {\n    ((x as u32) >> shift) as i32\n}\n\nfn cyrb53_finish(mut h1: i32, mut h2: i32) -> [u8; 16] {\n    h1 = imul(h1 ^ usr(h1, 16), 2246822507u32 as i32)\n        ^ imul(h2 ^ usr(h2, 13), 3266489909u32 as i32);\n    h2 = imul(h2 ^ usr(h2, 16), 2246822507u32 as i32)\n        ^ imul(h1 ^ usr(h1, 13), 3266489909u32 as i32);\n    let a = h1 as u32;\n    let b = h2 as u32;\n    let mut lo = [0u8; 8];\n    let mut hi = [0u8; 8];\n    write_hex8(a, &mut lo);\n    write_hex8(b, &mut hi);\n    let mut hex = [0u8; 16];\n    hex[0] = lo[0];\n    hex[1] = lo[1];\n    hex[2] = lo[2];\n    hex[3] = lo[3];\n    hex[4] = lo[4];\n    hex[5] = lo[5];\n    hex[6] = lo[6];\n    hex[7] = lo[7];\n    hex[8] = hi[0];\n    hex[9] = hi[1];\n    hex[10] = hi[2];\n    hex[11] = hi[3];\n    hex[12] = hi[4];\n    hex[13] = hi[5];\n    hex[14] = hi[6];\n    hex[15] = hi[7];\n    hex\n}\n\nfn hex_digit(nibble: u32) -> u8 {\n    HEX[(nibble & 0xf) as usize]\n}\n\nfn write_hex8(value: u32, out: &mut [u8; 8]) {\n    out[0] = hex_digit(value >> 28);\n    out[1] = hex_digit(value >> 24);\n    out[2] = hex_digit(value >> 20);\n    out[3] = hex_digit(value >> 16);\n    out[4] = hex_digit(value >> 12);\n    out[5] = hex_digit(value >> 8);\n    out[6] = hex_digit(value >> 4);\n    out[7] = hex_digit(value);\n}\n\n/// cyrb53 over UTF-16 code units, matching `hashString` in\n/// `packages/scraper/contentHash.ts` (`charCodeAt` iteration).\npub fn hash_utf16(units: &[u16]) -> [u8; 16] {\n    let mut h1: i32 = 0xdeadbeefu32 as i32;\n    let mut h2: i32 = 0x41c6ce57u32 as i32;\n    let mut i = 0;\n    while i < units.len() {\n        let ch = units[i] as i32;\n        h1 = imul(h1 ^ ch, 2654435761u32 as i32);\n        h2 = imul(h2 ^ ch, 1597334677u32 as i32);\n        i += 1;\n    }\n    cyrb53_finish(h1, h2)\n}\n\n/// cyrb53 over raw bytes (each byte is mixed as a code unit 0..=255).\n/// Used only by the v2 scheme.\npub fn hash_bytes(bytes: &[u8]) -> [u8; 16] {\n    let mut h1: i32 = 0xdeadbeefu32 as i32;\n    let mut h2: i32 = 0x41c6ce57u32 as i32;\n    let mut i = 0;\n    while i < bytes.len() {\n        let ch = bytes[i] as i32;\n        h1 = imul(h1 ^ ch, 2654435761u32 as i32);\n        h2 = imul(h2 ^ ch, 1597334677u32 as i32);\n        i += 1;\n    }\n    cyrb53_finish(h1, h2)\n}\n\n/// Legacy v1 input encoding: UTF-16 title, then `::`, then UTF-16 url.\n/// This function exists so the F-W2-2 collision can be stated exactly.\npub fn encode_v1_utf16(title: &[u16], url: &[u16], out: &mut [u16]) -> usize {\n    let need = title.len() + 2 + url.len();\n    let mut i = 0;\n    while i < title.len() {\n        out[i] = title[i];\n        i += 1;\n    }\n    out[i] = 0x3a;\n    i += 1;\n    out[i] = 0x3a;\n    i += 1;\n    let mut j = 0;\n    while j < url.len() {\n        out[i] = url[j];\n        i += 1;\n        j += 1;\n    }\n    let _ = need;\n    i\n}\n\n/// v2 input encoding: `u32be(len(title)) || title || u32be(len(url)) || url`.\n///\n/// This is injective on `(title, url)` byte-string pairs: the first four bytes\n/// tell the reader exactly how many title bytes follow, so a `::` (or any other\n/// byte sequence) inside the title cannot be confused with a delimiter.\npub fn encode_v2_bytes(title: &[u8], url: &[u8], out: &mut [u8]) -> Option<usize> {\n    if title.len() > (u32::MAX as usize) || url.len() > (u32::MAX as usize) {\n        return None;\n    }\n    let need = 8 + title.len() + url.len();\n    if out.len() < need {\n        return None;\n    }\n    write_u32be(title.len() as u32, &mut out[0..4]);\n    let mut i = 4;\n    let mut j = 0;\n    while j < title.len() {\n        out[i] = title[j];\n        i += 1;\n        j += 1;\n    }\n    write_u32be(url.len() as u32, &mut out[i..i + 4]);\n    i += 4;\n    j = 0;\n    while j < url.len() {\n        out[i] = url[j];\n        i += 1;\n        j += 1;\n    }\n    Some(i)\n}\n\nfn write_u32be(value: u32, out: &mut [u8]) {\n    out[0] = (value >> 24) as u8;\n    out[1] = (value >> 16) as u8;\n    out[2] = (value >> 8) as u8;\n    out[3] = value as u8;\n}\n\nfn cyrb53_start() -> (i32, i32) {\n    (0xdeadbeefu32 as i32, 0x41c6ce57u32 as i32)\n}\n\nfn cyrb53_mix_u16(h1: i32, h2: i32, ch: u16) -> (i32, i32) {\n    let c = ch as i32;\n    (imul(h1 ^ c, 2654435761u32 as i32), imul(h2 ^ c, 1597334677u32 as i32))\n}\n\nfn cyrb53_mix_u8(h1: i32, h2: i32, ch: u8) -> (i32, i32) {\n    let c = ch as i32;\n    (imul(h1 ^ c, 2654435761u32 as i32), imul(h2 ^ c, 1597334677u32 as i32))\n}\n\nfn cyrb53_mix_u32be(mut h1: i32, mut h2: i32, value: u32) -> (i32, i32) {\n    let b0 = (value >> 24) as u8;\n    let b1 = (value >> 16) as u8;\n    let b2 = (value >> 8) as u8;\n    let b3 = value as u8;\n    let t = cyrb53_mix_u8(h1, h2, b0);\n    h1 = t.0;\n    h2 = t.1;\n    let t = cyrb53_mix_u8(h1, h2, b1);\n    h1 = t.0;\n    h2 = t.1;\n    let t = cyrb53_mix_u8(h1, h2, b2);\n    h1 = t.0;\n    h2 = t.1;\n    cyrb53_mix_u8(h1, h2, b3)\n}\n\n/// Live TypeScript `toContentHash(title, url)`: UTF-16 `title::url` + cyrb53.\n/// Streamed (no scratch buffer) so the mix is identical to hashing the\n/// concatenated encoding.\npub fn content_hash_v1(title_utf16: &[u16], url_utf16: &[u16]) -> ContentHash {\n    let t = cyrb53_start();\n    let mut h1 = t.0;\n    let mut h2 = t.1;\n    let mut i = 0;\n    while i < title_utf16.len() {\n        let t = cyrb53_mix_u16(h1, h2, title_utf16[i]);\n        h1 = t.0;\n        h2 = t.1;\n        i += 1;\n    }\n    let t = cyrb53_mix_u16(h1, h2, 0x3a);\n    h1 = t.0;\n    h2 = t.1;\n    let t = cyrb53_mix_u16(h1, h2, 0x3a);\n    h1 = t.0;\n    h2 = t.1;\n    i = 0;\n    while i < url_utf16.len() {\n        let t = cyrb53_mix_u16(h1, h2, url_utf16[i]);\n        h1 = t.0;\n        h2 = t.1;\n        i += 1;\n    }\n    ContentHash {\n        version: ContentHashVersion::V1,\n        hex: cyrb53_finish(h1, h2),\n    }\n}\n\n/// Length-prefixed v2 hash. Output display is `v2:` + 16 hex chars.\n/// Returns `None` only if a length overflows `u32` (cannot happen for\n/// in-memory slices on this platform in practice, but the check is kept\n/// so the function never truncates silently).\npub fn content_hash_v2(title_utf8: &[u8], url_utf8: &[u8]) -> Option<ContentHash> {\n    if title_utf8.len() > (u32::MAX as usize) || url_utf8.len() > (u32::MAX as usize) {\n        return None;\n    }\n    let t = cyrb53_start();\n    let mut h1 = t.0;\n    let mut h2 = t.1;\n    let t = cyrb53_mix_u32be(h1, h2, title_utf8.len() as u32);\n    h1 = t.0;\n    h2 = t.1;\n    let mut i = 0;\n    while i < title_utf8.len() {\n        let t = cyrb53_mix_u8(h1, h2, title_utf8[i]);\n        h1 = t.0;\n        h2 = t.1;\n        i += 1;\n    }\n    let t = cyrb53_mix_u32be(h1, h2, url_utf8.len() as u32);\n    h1 = t.0;\n    h2 = t.1;\n    i = 0;\n    while i < url_utf8.len() {\n        let t = cyrb53_mix_u8(h1, h2, url_utf8[i]);\n        h1 = t.0;\n        h2 = t.1;\n        i += 1;\n    }\n    Some(ContentHash {\n        version: ContentHashVersion::V2,\n        hex: cyrb53_finish(h1, h2),\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn encode_str_utf16(s: &str, out: &mut [u16]) -> Option<usize> {\n        let mut n = 0;\n        for ch in s.encode_utf16() {\n            if n >= out.len() {\n                return None;\n            }\n            out[n] = ch;\n            n += 1;\n        }\n        Some(n)\n    }\n\n    fn v1_str(title: &str, url: &str) -> [u8; 16] {\n        let mut t = [0u16; 256];\n        let mut u = [0u16; 256];\n        let tn = encode_str_utf16(title, &mut t).unwrap();\n        let un = encode_str_utf16(url, &mut u).unwrap();\n        content_hash_v1(&t[..tn], &u[..un]).hex\n    }\n\n    fn v2_disp(title: &str, url: &str) -> [u8; 19] {\n        let h = content_hash_v2(title.as_bytes(), url.as_bytes()).unwrap();\n        let mut out = [0u8; 19];\n        let n = h.display(&mut out);\n        assert_eq!(n, 19);\n        out\n    }\n\n    fn hex16(h: [u8; 16]) -> String {\n        String::from_utf8(h.to_vec()).unwrap()\n    }\n\n    #[test]\n    fn hash_string_matches_typescript_fixtures() {\n        let empty: [u16; 0] = [];\n        assert_eq!(hex16(hash_utf16(&empty)), \"1aee8d83488bdcb8\");\n        let mut hello = [0u16; 8];\n        let n = encode_str_utf16(\"hello\", &mut hello).unwrap();\n        assert_eq!(hex16(hash_utf16(&hello[..n])), \"63cd7226bfb06f3a\");\n        let mut a = [0u16; 2];\n        let n = encode_str_utf16(\"A\", &mut a).unwrap();\n        assert_eq!(hex16(hash_utf16(&a[..n])), \"f46a017db3afc47f\");\n    }\n\n    #[test]\n    fn v1_matches_typescript_tocontenthash() {\n        assert_eq!(\n            hex16(v1_str(\n                \"Virtual Assistant — Remote\",\n                \"https://example.invalid/jobs/1\"\n            )),\n            \"2436a0baf741a4d9\"\n        );\n        assert_eq!(\n            hex16(v1_str(\n                \"Virtual Assistant — Remote\",\n                \"https://example.invalid/jobs/2\"\n            )),\n            \"04aabe617b503925\"\n        );\n    }\n\n    #[test]\n    fn f_w2_2_v1_colon_alias_is_real() {\n        // Characterization of the live TypeScript bug, preserved as a fixture.\n        let left = v1_str(\"A\", \"B::C\");\n        let right = v1_str(\"A::B\", \"C\");\n        assert_eq!(hex16(left), \"5e24bcea38eadbb7\");\n        assert_eq!(left, right);\n        let left2 = v1_str(\"Engineer::Senior\", \"https://example.invalid/x\");\n        let right2 = v1_str(\"Engineer\", \"Senior::https://example.invalid/x\");\n        assert_eq!(hex16(left2), \"35b59c9cb6bcbc33\");\n        assert_eq!(left2, right2);\n    }\n\n    #[test]\n    fn f_w2_2_v2_length_prefix_rejects_the_alias() {\n        let left = v2_disp(\"A\", \"B::C\");\n        let right = v2_disp(\"A::B\", \"C\");\n        assert_ne!(left, right);\n        assert!(ContentHash::is_v2_display(&left));\n        assert!(ContentHash::is_v2_display(&right));\n        let left2 = v2_disp(\"Engineer::Senior\", \"https://example.invalid/x\");\n        let right2 = v2_disp(\"Engineer\", \"Senior::https://example.invalid/x\");\n        assert_ne!(left2, right2);\n    }\n\n    #[test]\n    fn v2_display_cannot_collide_with_v1_row_shape() {\n        let v1 = v1_str(\"A\", \"https://example.invalid/x\");\n        assert_eq!(v1.len(), 16);\n        let v2 = v2_disp(\"A\", \"https://example.invalid/x\");\n        assert_eq!(v2.len(), 19);\n        assert_ne!(&v2[3..], &v1[..]); // not required, but prefix already distinguishes\n        assert_eq!(&v2[..3], b\"v2:\");\n    }\n\n    #[test]\n    fn v2_encoding_roundtrip_lengths() {\n        let title = b\"hello\";\n        let url = b\"https://example.invalid/x\";\n        let mut buf = [0u8; 64];\n        let n = encode_v2_bytes(title, url, &mut buf).unwrap();\n        assert_eq!(n, 8 + title.len() + url.len());\n        assert_eq!(&buf[0..4], &[0, 0, 0, 5]);\n        assert_eq!(&buf[4..9], b\"hello\");\n        assert_eq!(&buf[9..13], &[0, 0, 0, url.len() as u8]);\n        assert_eq!(&buf[13..n], url);\n    }\n\n    #[test]\n    fn v1_is_deterministic() {\n        assert_eq!(\n            v1_str(\"Virtual Assistant — Remote\", \"https://example.invalid/jobs/1\"),\n            v1_str(\"Virtual Assistant — Remote\", \"https://example.invalid/jobs/1\")\n        );\n    }\n}\n"},{"id":13,"name":{"Local":"src/processing_mode.rs"},"crate_name":"vfh_math_core","contents":"//! MATH-10 - exclusive processing-mode selection with material-digest invalidation.\n//!\n//! The TypeScript `selectProcessingMode` in `scripts/lake/source-ranker.ts`\n//! (characterized in `scripts/lake/math-wave2-characterization.test.ts`) reads\n//! `version_deps` but does not compare `material_digests` values. A changed\n//! content hash under an unchanged `content_hash_version` is therefore still\n//! classified `REUSE`. That is finding F-W2-1.\n//!\n//! This module:\n//! - [`select_processing_mode_legacy`] reproduces that TypeScript behaviour for\n//!   parity tests (including the F-W2-1 fixture, which must stay `Reuse`).\n//! - [`select_processing_mode`] is the Wave 1 corrected selector: when a cached\n//!   digest snapshot is supplied and a material field changed, the mode is\n//!   `BoundedReplay` with an `Identity` dependency, after opt-out / expiry\n//!   (which still outrank) and alongside the existing version ladder.\n\nuse crate::types::{Dependency, MaterialDigests, VersionDeps};\n\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub enum ProcessingMode {\n    Full,\n    Reindex,\n    Reuse,\n    BoundedReplay,\n}\n\n#[derive(Clone, Copy)]\n#[cfg_attr(test, derive(Debug))]\npub struct ModeInput<'a> {\n    pub opt_out: bool,\n    /// Absolute milliseconds, if a policy lease exists. Unparseable TypeScript\n    /// dates are mapped to `None` by the (future) TS façade, matching the live\n    /// `new Date(invalid) < new Date()` behaviour (the comparison is false).\n    pub policy_expiry_ms: Option<u64>,\n    pub lease_expiry_ms: Option<u64>,\n    pub version_deps: VersionDeps<'a>,\n    pub last_qualified_ready: i32,\n    pub last_candidate_count: i32,\n    pub material_digests: MaterialDigests<'a>,\n}\n\n#[derive(Clone, Copy)]\n#[cfg_attr(test, derive(Debug))]\npub struct ModeDecision {\n    pub mode: ProcessingMode,\n    pub reason: &'static str,\n    pub dependency_count: usize,\n}\n\nconst MAX_DEPS: usize = 8;\n\nfn push_dep(deps: &mut [Dependency; MAX_DEPS], count: &mut usize, dep: Dependency) {\n    if *count < MAX_DEPS {\n        deps[*count] = dep;\n        *count += 1;\n    }\n}\n\nfn is_unknown_version(value: &str) -> bool {\n    if value.is_empty() {\n        return true;\n    }\n    value == \"unknown\" || value == \"unversioned\"\n}\n\nfn check_version_mismatch(\n    stored: VersionDeps<'_>,\n    current: VersionDeps<'_>,\n    out: &mut [Dependency; MAX_DEPS],\n    has_unknown: &mut bool,\n) -> usize {\n    let mut n = 0;\n    // Order matches source-ranker.ts checkVersionMismatch.\n    check_one(stored.policy_version, current.policy_version, Dependency::Policy, out, &mut n, has_unknown);\n    check_one(stored.processor_version, current.processor_version, Dependency::Parser, out, &mut n, has_unknown);\n    check_one(stored.geo_gate_version, current.geo_gate_version, Dependency::Geo, out, &mut n, has_unknown);\n    check_one(stored.triage_version, current.triage_version, Dependency::Taxonomy, out, &mut n, has_unknown);\n    check_one(stored.jev_version, current.jev_version, Dependency::Model, out, &mut n, has_unknown);\n    check_one(stored.fingerprint_version, current.fingerprint_version, Dependency::Identity, out, &mut n, has_unknown);\n    check_one(stored.content_hash_version, current.content_hash_version, Dependency::Identity, out, &mut n, has_unknown);\n    n\n}\n\nfn check_one(\n    stored: &str,\n    current: &str,\n    dep: Dependency,\n    out: &mut [Dependency; MAX_DEPS],\n    n: &mut usize,\n    has_unknown: &mut bool,\n) {\n    if stored != current {\n        push_dep(out, n, dep);\n        if is_unknown_version(stored) {\n            *has_unknown = true;\n        }\n    }\n}\n\nfn is_targeted(dep: Dependency) -> bool {\n    matches!(\n        dep,\n        Dependency::Geo | Dependency::Taxonomy | Dependency::Identity | Dependency::Policy\n    )\n}\n\n/// Material-field comparison used by the F-W2-1 fix.\n///\n/// `description_hash` is optional in the live contract: a missing description\n/// alone does not disqualify `REUSE` in the TypeScript characterization, so a\n/// `None` on either side is not treated as a change. If both are present and\n/// differ, that is a material change.\npub fn material_digests_changed(current: MaterialDigests<'_>, cached: MaterialDigests<'_>) -> bool {\n    if current.fingerprint_hash != cached.fingerprint_hash {\n        return true;\n    }\n    if current.content_hash != cached.content_hash {\n        return true;\n    }\n    if current.policy_hash != cached.policy_hash {\n        return true;\n    }\n    match (current.description_hash, cached.description_hash) {\n        (Some(a), Some(b)) => a != b,\n        _ => false,\n    }\n}\n\nfn sufficient_evidence(input: &ModeInput<'_>) -> bool {\n    input.last_qualified_ready > 0\n        && input.last_candidate_count > 0\n        && !input.material_digests.fingerprint_hash.is_empty()\n        && !input.material_digests.content_hash.is_empty()\n}\n\nfn decide_legacy(\n    input: &ModeInput<'_>,\n    current: VersionDeps<'_>,\n    now_ms: u64,\n) -> (ProcessingMode, &'static str, [Dependency; MAX_DEPS], usize) {\n    let empty = [Dependency::Geo; MAX_DEPS];\n    if input.opt_out {\n        let mut deps = empty;\n        let mut n = 0;\n        push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n        push_dep(&mut deps, &mut n, Dependency::Policy);\n        return (\n            ProcessingMode::BoundedReplay,\n            \"Source opted out - withdrawal propagation required\",\n            deps,\n            n,\n        );\n    }\n    if let Some(exp) = input.policy_expiry_ms {\n        if exp < now_ms {\n            let mut deps = empty;\n            let mut n = 0;\n            push_dep(&mut deps, &mut n, Dependency::Policy);\n            push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Policy lease expired - re-evaluation required\",\n                deps,\n                n,\n            );\n        }\n    }\n    if let Some(exp) = input.lease_expiry_ms {\n        if exp < now_ms {\n            let mut deps = empty;\n            let mut n = 0;\n            push_dep(&mut deps, &mut n, Dependency::SourceAuthority);\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Evidence lease expired - fresh evidence required\",\n                deps,\n                n,\n            );\n        }\n    }\n\n    let mut mismatches = empty;\n    let mut has_unknown = false;\n    let n = check_version_mismatch(input.version_deps, current, &mut mismatches, &mut has_unknown);\n    if n > 0 {\n        if has_unknown {\n            return (\n                ProcessingMode::Full,\n                \"Unknown version dependency - conservative FULL required\",\n                mismatches,\n                n,\n            );\n        }\n        if n == 1 && is_targeted(mismatches[0]) {\n            return (\n                ProcessingMode::BoundedReplay,\n                \"Targeted dependency version change\",\n                mismatches,\n                n,\n            );\n        }\n        return (\n            ProcessingMode::Reindex,\n            \"Version mismatch\",\n            mismatches,\n            n,\n        );\n    }\n\n    if sufficient_evidence(input) {\n        return (ProcessingMode::Reuse, \"Sufficient compatible evidence exists; no dependency changes\", empty, 0);\n    }\n    (\n        ProcessingMode::Full,\n        \"Insufficient prior evidence or first evaluation\",\n        empty,\n        0,\n    )\n}\n\n/// TypeScript-parity selector. Preserves F-W2-1 (`Reuse` despite a digest\n/// change) because the live function never receives a cached digest.\npub fn select_processing_mode_legacy(\n    input: &ModeInput<'_>,\n    current: VersionDeps<'_>,\n    now_ms: u64,\n) -> ModeDecision {\n    let (mode, reason, _deps, n) = decide_legacy(input, current, now_ms);\n    ModeDecision {\n        mode,\n        reason,\n        dependency_count: n,\n    }\n}\n\n/// Corrected Wave 1 selector. `cached_digests` is the digest snapshot the\n/// cached decision was produced under. When it is `None`, behaviour matches\n/// the legacy selector. When it is `Some` and a material field changed, a\n/// version-compatible record is no longer `Reuse`.\npub fn select_processing_mode(\n    input: &ModeInput<'_>,\n    current: VersionDeps<'_>,\n    now_ms: u64,\n    cached_digests: Option<MaterialDigests<'_>>,\n) -> ModeDecision {\n    let (mode, reason, _deps, n) = decide_legacy(input, current, now_ms);\n    // Opt-out, expiry, version mismatch and insufficient evidence already\n    // outrank a digest comparison. Only a would-be Reuse is upgraded.\n    if mode == ProcessingMode::Reuse {\n        if let Some(cached) = cached_digests {\n            if material_digests_changed(input.material_digests, cached) {\n                return ModeDecision {\n                    mode: ProcessingMode::BoundedReplay,\n                    reason: \"Material digest changed - cached mode is not content-valid\",\n                    dependency_count: 1,\n                };\n            }\n        }\n    }\n    ModeDecision {\n        mode,\n        reason,\n        dependency_count: n,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::types::{CURRENT_VERSIONS, CONTENT_HASH_VERSION_V2, MaterialDigests, VersionDeps};\n\n    const T0: u64 = 1_000_000;\n    const NOW: u64 = 2_000_000;\n\n    fn digests() -> MaterialDigests<'static> {\n        MaterialDigests {\n            fingerprint_hash: \"fp-1\",\n            content_hash: \"ch-1\",\n            description_hash: Some(\"dh-1\"),\n            policy_hash: \"ph-1\",\n        }\n    }\n\n    fn input() -> ModeInput<'static> {\n        ModeInput {\n            opt_out: false,\n            policy_expiry_ms: None,\n            lease_expiry_ms: None,\n            version_deps: CURRENT_VERSIONS,\n            last_qualified_ready: 3,\n            last_candidate_count: 5,\n            material_digests: digests(),\n        }\n    }\n\n    #[test]\n    fn opt_out_outranks_everything() {\n        let mut i = input();\n        i.opt_out = true;\n        let changed = MaterialDigests {\n            content_hash: \"ch-CHANGED\",\n            ..digests()\n        };\n        i.material_digests = changed;\n        let d = select_processing_mode(&i, CURRENT_VERSIONS, NOW, Some(digests()));\n        assert_eq!(d.mode, ProcessingMode::BoundedReplay);\n        assert!(d.reason.contains(\"opted out\"));\n    }\n\n    #[test]\n    fn policy_and_lease_expiry_force_bounded_replay() {\n        let mut i = input();\n        i.policy_expiry_ms = Some(T0);\n        assert_eq!(\n            select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::BoundedReplay\n        );\n        let mut j = input();\n        j.lease_expiry_ms = Some(T0);\n        assert_eq!(\n            select_processing_mode_legacy(&j, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::BoundedReplay\n        );\n        // A future expiry is not expired.\n        let mut k = input();\n        k.policy_expiry_ms = Some(NOW + 10);\n        assert_eq!(\n            select_processing_mode_legacy(&k, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::Reuse\n        );\n    }\n\n    #[test]\n    fn targeted_content_hash_version_is_bounded_replay() {\n        let mut i = input();\n        i.version_deps = VersionDeps {\n            content_hash_version: CONTENT_HASH_VERSION_V2,\n            ..CURRENT_VERSIONS\n        };\n        let d = select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW);\n        assert_eq!(d.mode, ProcessingMode::BoundedReplay);\n    }\n\n    #[test]\n    fn unknown_version_is_full() {\n        let mut i = input();\n        i.version_deps = VersionDeps {\n            policy_version: \"unknown\",\n            ..CURRENT_VERSIONS\n        };\n        let d = select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW);\n        assert_eq!(d.mode, ProcessingMode::Full);\n    }\n\n    #[test]\n    fn insufficient_evidence_is_full() {\n        let mut i = input();\n        i.last_qualified_ready = 0;\n        assert_eq!(\n            select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::Full\n        );\n        let mut j = input();\n        j.material_digests = MaterialDigests {\n            content_hash: \"\",\n            ..digests()\n        };\n        assert_eq!(\n            select_processing_mode_legacy(&j, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::Full\n        );\n        // Missing description alone still reuses (TypeScript characterization).\n        let mut k = input();\n        k.material_digests = MaterialDigests {\n            description_hash: None,\n            ..digests()\n        };\n        assert_eq!(\n            select_processing_mode_legacy(&k, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::Reuse\n        );\n    }\n\n    #[test]\n    fn f_w2_1_legacy_reuses_changed_digest() {\n        let mut i = input();\n        i.material_digests = MaterialDigests {\n            content_hash: \"ch-CHANGED\",\n            ..digests()\n        };\n        // The live TypeScript function has no cached-digest argument, so a\n        // changed hash with matching versions is still Reuse.\n        let d = select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW);\n        assert_eq!(d.mode, ProcessingMode::Reuse);\n        // The corrected selector, given the previously cached digests, refuses.\n        let fixed = select_processing_mode(&i, CURRENT_VERSIONS, NOW, Some(digests()));\n        assert_eq!(fixed.mode, ProcessingMode::BoundedReplay);\n        assert!(fixed.reason.contains(\"Material digest changed\"));\n    }\n\n    #[test]\n    fn corrected_selector_reuses_when_digests_match() {\n        let i = input();\n        let d = select_processing_mode(&i, CURRENT_VERSIONS, NOW, Some(digests()));\n        assert_eq!(d.mode, ProcessingMode::Reuse);\n    }\n\n    #[test]\n    fn processor_or_model_mismatch_is_reindex() {\n        let mut i = input();\n        i.version_deps = VersionDeps {\n            processor_version: \"capability-registry@0.0.0\",\n            ..CURRENT_VERSIONS\n        };\n        assert_eq!(\n            select_processing_mode_legacy(&i, CURRENT_VERSIONS, NOW).mode,\n            ProcessingMode::Reindex\n        );\n    }\n}\n"},{"id":14,"name":{"Local":"src/types.rs"},"crate_name":"vfh_math_core","contents":"//! MATH-00 — exact shared types and version tags for the Wave 1 core.\n//!\n//! These types are deliberately narrower than the TypeScript `SourceMemoryRecord`.\n//! The TypeScript layer (not in this crate) remains responsible for I/O, ISO-8601\n//! parsing, and mapping a live record onto [`ModeInput`](crate::ModeInput).\n\n/// Contract version for this Wave 1 core. Bump only when the math rules change.\npub const WAVE1_CONTRACT_VERSION: u32 = 1;\n\n/// Stored / declared content-hash scheme. `contentHash@v1` is the live D1 scheme\n/// and must not be rewritten in place. `contentHash@v2` is the length-prefixed\n/// scheme that closes F-W2-2.\npub const CONTENT_HASH_VERSION_V1: &str = \"contentHash@v1\";\npub const CONTENT_HASH_VERSION_V2: &str = \"contentHash@v2\";\n\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub enum ContentHashVersion {\n    V1,\n    V2,\n}\n\nimpl ContentHashVersion {\n    pub fn tag(self) -> &'static str {\n        match self {\n            ContentHashVersion::V1 => CONTENT_HASH_VERSION_V1,\n            ContentHashVersion::V2 => CONTENT_HASH_VERSION_V2,\n        }\n    }\n}\n\n/// Version dependency snapshot. Null TypeScript fields are represented as empty\n/// slices so the core stays allocation-friendly for Aeneas.\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub struct VersionDeps<'a> {\n    pub policy_version: &'a str,\n    pub processor_version: &'a str,\n    pub geo_gate_version: &'a str,\n    pub triage_version: &'a str,\n    pub jev_version: &'a str,\n    pub fingerprint_version: &'a str,\n    pub content_hash_version: &'a str,\n}\n\n/// Material content digests for a source/job snapshot (SSAE-02 / MATH-10).\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub struct MaterialDigests<'a> {\n    pub fingerprint_hash: &'a str,\n    pub content_hash: &'a str,\n    pub description_hash: Option<&'a str>,\n    pub policy_hash: &'a str,\n}\n\n/// Dependency kinds that invalidate a cached decision. Names match the\n/// TypeScript `Dependency` union in `scripts/lake/source-ranker.ts`.\n#[derive(Clone, Copy, PartialEq, Eq)]\n#[cfg_attr(test, derive(Debug))]\npub enum Dependency {\n    Geo,\n    Remote,\n    Identity,\n    Url,\n    SourceAuthority,\n    Policy,\n    Parser,\n    Schema,\n    Model,\n    Taxonomy,\n}\n\n/// Current TypeScript defaults, mirrored for parity tests. Not a live\n/// deployment attestation.\npub const CURRENT_VERSIONS: VersionDeps<'static> = VersionDeps {\n    policy_version: \"constitution-v5.2\",\n    processor_version: \"capability-registry@1.0.0\",\n    geo_gate_version: \"geoGate@2026-09-15\",\n    triage_version: \"triage@1.0.0\",\n    jev_version: \"jev-1.13\",\n    fingerprint_version: \"fingerprint@v1\",\n    content_hash_version: CONTENT_HASH_VERSION_V1,\n};\n"},{"id":15,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/num/int_macros.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/str/mod.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/str/traits.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/macros/mod.rs"},"crate_name":"core","content